{
  "name": "bijiang-explorer-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "backup": "node scripts/backup-db.js",
    "restore": "node scripts/restore-db.js",
    "content:update": "node scripts/update-spot.js",
