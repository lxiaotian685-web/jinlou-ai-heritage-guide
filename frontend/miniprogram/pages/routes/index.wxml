<view class="page arc-page arc-grid-bg routes-page {{displayClass}}">
  <view class="routes-head">
    <view class="routes-head__top">
      <text class="arc-eyebrow">ROUTES / 游线</text>
      <view class="routes-head__tools">
        <text class="routes-head__folio">NO. 06</text>
        <button class="arc-text-btn routes-head__back" bindtap="backHome">返回首页</button>
      </view>
    </view>
    <view class="routes-head__main">
      <view class="routes-head__copy">
        <text class="arc-title serif routes-head__title">循迹慢游</text>
        <text class="arc-lede">根据兴趣选择游览主题</text>
      </view>
      <view class="arc-seal routes-head__seal">线</view>
    </view>
    <view class="routes-head__rule">
      <view class="routes-head__rule-line"></view>
      <text class="routes-head__rule-meta">BIJIANG · ROUTES</text>
    </view>
  </view>

  <view class="routes-body">
    <view wx:if="{{offlineNotice}}" class="routes-offline">{{offlineNotice}}</view>

    <view class="routes-planner arc-card arc-card--ticks">
      <view class="routes-planner__copy">
        <text class="arc-eyebrow">PERSONAL ROUTE</text>
        <text class="routes-planner__title serif">按时间与兴趣规划</text>
        <text class="routes-planner__body">选择45、90或120分钟，以及同行人与兴趣，生成只包含现有景点的游览建议。</text>
      </view>
      <button class="arc-btn routes-planner__action" bindtap="openItineraryPlanner">开始规划</button>
    </view>

    <view wx:if="{{selectedRouteId}}" class="routes-current arc-card arc-card--ticks">
      <view class="routes-current__copy">
        <text class="arc-eyebrow">当前已选路线</text>
        <text class="routes-current__name serif">{{selectedRouteName}}</text>
        <text class="routes-current__hint">导览图会按这条路线显示点位顺序</text>
      </view>
      <button class="arc-btn arc-btn--ghost routes-current__clear" bindtap="clearSelectedRoute">清除路线</button>
    </view>

    <view wx:if="{{loading}}" class="routes-state arc-card arc-card--ticks">
      <text class="arc-eyebrow">READING THE ROUTE ARCHIVE</text>
      <text class="routes-state__title serif">正在读取推荐游线…</text>
      <view class="routes-state__line"></view>
    </view>

    <view wx:elif="{{error}}" class="arc-empty routes-error">
      <text class="arc-eyebrow">ROUTE ARCHIVE UNAVAILABLE</text>
      <text class="routes-error__title serif">推荐游线未能送达</text>
      <text class="routes-error__body">{{error}}</text>
      <view class="arc-empty__rule"></view>
      <button class="arc-btn routes-error__btn" bindtap="loadRoutes">重新加载</button>
    </view>

    <view wx:elif="{{!routes.length}}" class="arc-empty routes-empty">
      <text class="arc-eyebrow">NO ROUTES</text>
      <text class="routes-empty__title serif">暂无推荐游线</text>
      <view class="arc-empty__rule"></view>
      <text class="routes-empty__body">暂无推荐游线，请稍后重试。</text>
      <button class="arc-btn routes-empty__btn" bindtap="backHome">返回首页</button>
    </view>

    <view wx:else class="routes-list">
      <view wx:for="{{routes}}" wx:key="id" class="routes-card arc-card">
        <view class="routes-card__head" hover-class="routes-card__head--press" aria-role="button" aria-label="{{expandedId === item.id ? '收起' : '展开'}}：{{item.name}}" data-id="{{item.id}}" bindtap="toggleRoute">
          <view class="routes-card__copy">
            <view class="routes-card__name-row">
              <text class="routes-card__name serif">{{item.name}}</text>
              <view class="arc-tag routes-card__verify"><text>{{item.verificationLabel}}</text></view>
            </view>
            <text class="routes-card__theme">{{item.theme}}</text>
          </view>
          <view class="routes-card__toggle">
            <text class="routes-card__toggle-text">{{expandedId === item.id ? '收起' : '展开'}}</text>
            <view class="routes-card__chevron {{expandedId === item.id ? 'routes-card__chevron--up' : ''}}"></view>
          </view>
        </view>

        <view class="routes-card__meta">
          <view class="arc-tag routes-card__meta-tag"><text>{{item.duration}}</text></view>
          <view class="arc-tag routes-card__meta-tag"><text>{{item.audience}}</text></view>
        </view>

        <view wx:if="{{expandedId === item.id}}" class="routes-card__detail">
          <view class="arc-hair routes-card__hair"></view>
          <text class="routes-card__passage">{{item.passageNotice}}</text>
          <view class="routes-card__stops">
            <view wx:for="{{item.stops}}" wx:for-item="stop" wx:for-index="stopIndex" wx:key="*this" class="routes-stop">
              <view class="routes-stop__num"><text>{{stopIndex + 1}}</text></view>
              <text class="routes-stop__text">{{stop}}</text>
            </view>
          </view>
          <view class="routes-card__actions">
            <button class="arc-btn routes-card__action" data-id="{{item.id}}" bindtap="openOnGuide">在导览图中查看</button>
            <button class="arc-btn arc-btn--ghost routes-card__action" open-type="share" data-id="{{item.id}}">分享这条路线</button>
          </view>
        </view>
      </view>
    </view>

    <view class="routes-foot">
      <view class="arc-hair arc-hair--dot"><text>END OF ROUTES</text></view>
      <text class="routes-foot__note">可按兴趣选择路线，并在导览图中查看点位</text>
    </view>
  </view>
</view>
