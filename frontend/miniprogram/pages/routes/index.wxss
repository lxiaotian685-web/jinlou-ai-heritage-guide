@import "../../styles/archive.wxss";

/* ==========================================================================
   推荐游线 · B 蚝壳青灰
   浅色档案页头；游线按档案卡排版，展开区以细线分隔。
   ========================================================================== */

.routes-page {
  box-sizing: border-box;
  padding: 0 32rpx calc(52rpx + env(safe-area-inset-bottom));
}

/* ---------- 页头 ---------- */
.routes-head {
  padding: 36rpx 0 0;
}

.routes-head__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.routes-head__tools {
  flex: none;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.routes-head__folio {
  flex: none;
  font-size: 18rpx;
  line-height: 1.5;
  letter-spacing: 3rpx;
  color: var(--arc-muted);
}

.routes-head__back {
  flex: none;
}

.routes-head__main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 16rpx;
}

.routes-head__copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.routes-head__title {
  font-size: 64rpx;
  letter-spacing: 6rpx;
}

.routes-head__seal {
  flex: none;
  margin-top: 6rpx;
}

.routes-head__rule {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 26rpx;
}

.routes-head__rule-line {
  flex: 1;
  height: 1rpx;
  background: var(--arc-line-strong);
}

.routes-head__rule-meta {
  flex: none;
  font-size: 18rpx;
  line-height: 1.5;
  letter-spacing: 3rpx;
  color: var(--arc-muted);
}

.routes-body {
  padding-top: 26rpx;
}

.routes-planner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  margin-bottom: 22rpx;
  padding: 26rpx;
  border-left: 4rpx solid #3a5a47;
}

.routes-planner__copy {
  flex: 1;
  min-width: 0;
}

.routes-planner__title,
.routes-planner__body {
  display: block;
}

.routes-planner__title {
  margin-top: 8rpx;
  font-size: 32rpx;
  line-height: 1.4;
}

.routes-planner__body {
  margin-top: 7rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: var(--arc-muted);
}

.routes-planner__action {
  flex: none;
  width: 176rpx;
  min-height: 82rpx;
  padding: 0 14rpx;
  font-size: 23rpx;
}

/* ---------- 离线提示 ---------- */
.routes-offline {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  background: var(--arc-cream);
  border: 1rpx solid var(--arc-line);
  border-left: 3rpx solid var(--arc-red);
  border-radius: 4rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--arc-blue);
}

/* ---------- 加载 / 错误 ---------- */
.routes-state {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 22rpx;
  padding: 32rpx;
}

.routes-state__title {
  font-size: 34rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
  color: var(--arc-ink);
}

.routes-state__line {
  width: 88rpx;
  height: 2rpx;
  background: var(--arc-red);
}

.routes-error {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14rpx;
}

.routes-error__title {
  font-size: 36rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
  color: var(--arc-ink);
}

.routes-error__body {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--arc-muted);
}

.routes-error__btn {
  width: auto;
  min-width: 260rpx;
  min-height: 88rpx;
  margin-top: 4rpx;
}

/* ---------- 空状态 ---------- */
.routes-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.routes-empty__title {
  font-size: 34rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
  color: var(--arc-ink);
}

.routes-empty__body {
  max-width: 540rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: var(--arc-muted);
  text-align: center;
}

.routes-empty__btn {
  width: auto;
  min-width: 260rpx;
  min-height: 88rpx;
  margin-top: 6rpx;
}

/* ---------- 游线列表 ---------- */
.routes-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.routes-card {
  padding: 24rpx 26rpx 26rpx;
}

.routes-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 88rpx;
}

.routes-card__head--press .routes-card__name {
  color: var(--arc-red);
}

.routes-card__head--press .routes-card__chevron {
  border-color: var(--arc-red);
}

.routes-card__copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.routes-card__name-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 12rpx;
}

.routes-card__name {
  font-size: 36rpx;
  line-height: 1.35;
  letter-spacing: 1rpx;
  color: var(--arc-ink);
  transition: color 160ms ease;
}

.routes-card__verify {
  flex: none;
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: var(--arc-blue);
}

.routes-card__theme {
  font-size: 25rpx;
  line-height: 1.7;
  letter-spacing: 0.5rpx;
  color: var(--arc-muted);
}

.routes-card__toggle {
  flex: none;
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 64rpx;
  padding-top: 4rpx;
}

.routes-card__toggle-text {
  font-size: 22rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
  color: var(--arc-muted);
}

.routes-card__chevron {
  width: 12rpx;
  height: 12rpx;
  margin-top: -6rpx;
  border-right: 2rpx solid var(--arc-muted);
  border-bottom: 2rpx solid var(--arc-muted);
  transform: rotate(45deg);
  transition: transform 180ms ease, border-color 160ms ease;
}

.routes-card__chevron--up {
  margin-top: 6rpx;
  transform: rotate(-135deg);
}

.routes-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.routes-card__meta-tag {
  padding: 5rpx 12rpx;
  font-size: 20rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
  color: var(--arc-blue);
}

.routes-card__detail {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.routes-card__hair {
  margin-bottom: 2rpx;
}

.routes-card__passage {
  padding: 14rpx 16rpx;
  background: var(--arc-oyster);
  border-left: 2rpx solid var(--arc-line-strong);
  font-size: 24rpx;
  line-height: 1.75;
  letter-spacing: 0.5rpx;
  color: var(--arc-blue);
}

.routes-card__stops {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.routes-stop {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 44rpx;
}

.routes-stop__num {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 34rpx;
  height: 34rpx;
  border: 1rpx solid var(--arc-line-strong);
  border-radius: 50%;
  font-family: "Songti SC", "Noto Serif SC", SimSun, serif;
  font-size: 18rpx;
  line-height: 1;
  letter-spacing: 1rpx;
  color: var(--arc-blue);
}

.routes-stop__text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--arc-ink);
}

.routes-card__actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 2rpx;
}

.routes-card__action {
  min-height: 88rpx;
  padding: 0 12rpx;
  font-size: 25rpx;
  letter-spacing: 1rpx;
}

/* ---------- 页脚 ---------- */
.routes-foot {
  margin-top: 40rpx;
}

.routes-foot__note {
  display: block;
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.7;
  letter-spacing: 1rpx;
  color: var(--arc-muted);
}

/* ---------- 大字模式 ---------- */
.font-large .routes-head__title {
  font-size: 76rpx;
}

.font-large .routes-head__back {
  font-size: 26rpx;
}

.font-large .routes-state__title,
.font-large .routes-error__title,
.font-large .routes-empty__title {
  font-size: 40rpx;
}

.font-large .routes-error__body,
.font-large .routes-empty__body,
.font-large .routes-foot__note {
  font-size: 28rpx;
}

.font-large .routes-card__name {
  font-size: 44rpx;
}

.font-large .routes-card__verify,
.font-large .routes-card__meta-tag {
  font-size: 24rpx;
}

.font-large .routes-card__theme {
  font-size: 31rpx;
}

.font-large .routes-card__toggle-text {
  font-size: 28rpx;
}

.font-large .routes-card__passage,
.font-large .routes-stop__text {
  font-size: 30rpx;
  line-height: 1.8;
}

.font-large .routes-stop__num {
  width: 40rpx;
  height: 40rpx;
  font-size: 22rpx;
}

.font-large .routes-card__actions {
  grid-template-columns: 1fr;
}

.font-large .routes-planner {
  align-items: stretch;
  flex-direction: column;
}

.font-large .routes-planner__title {
  font-size: 38rpx;
}

.font-large .routes-planner__body {
  font-size: 27rpx;
}

.font-large .routes-planner__action {
  width: 100%;
}

.font-large .routes-card__action,
.font-large .routes-error__btn,
.font-large .routes-empty__btn {
  min-height: 96rpx;
}

/* ---------- 高对比 ---------- */
.routes-page.high-contrast {
  background-color: #fff;
  background-image: none;
}

.high-contrast .arc-card,
.high-contrast .arc-empty {
  background: #fff;
  border-color: #393939;
}

.high-contrast .routes-offline {
  background: #fff;
  border-color: #393939;
  border-left-color: var(--arc-red);
  color: #111;
}

.high-contrast .routes-head__folio,
.high-contrast .routes-head__rule-meta,
.high-contrast .routes-card__verify,
.high-contrast .routes-card__meta-tag {
  color: #222;
}

.high-contrast .routes-head__back {
  border: 0;
  border-bottom: 2rpx solid #111;
  color: #111;
}

.high-contrast .arc-hair--dot {
  background: transparent;
}

.high-contrast .arc-hair--dot::before,
.high-contrast .arc-hair--dot::after {
  background: #393939;
}

.high-contrast .routes-card__name,
.high-contrast .routes-stop__text {
  color: #111;
}

.high-contrast .routes-card__theme,
.high-contrast .routes-card__toggle-text,
.high-contrast .routes-error__body,
.high-contrast .routes-foot__note {
  color: #222;
}

.high-contrast .routes-card__passage {
  background: #fff;
  border-left-color: #393939;
  color: #111;
}

.high-contrast .routes-card__verify,
.high-contrast .routes-card__meta-tag,
.high-contrast .routes-empty__body,
.high-contrast .routes-stop__num {
  border-color: #393939;
  color: #111;
}

@media (prefers-reduced-motion: reduce) {
  .routes-card__name,
  .routes-card__chevron {
    transition: none;
  }
}


.routes-current {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
}

.routes-current__copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.routes-current__name {
  font-size: 34rpx;
  color: #1f3327;
}

.routes-current__hint {
  font-size: 24rpx;
  color: #6b7269;
}

.routes-current__clear {
  flex: 0 0 auto;
  min-width: 168rpx;
  padding: 0 24rpx;
}
