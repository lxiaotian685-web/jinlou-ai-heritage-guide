.heading-row { display:flex; justify-content:space-between; align-items:flex-start; gap:20rpx; margin-bottom:24rpx; }.heading { display:flex; flex-direction:column; gap:10rpx; }.heading .muted { font-size:24rpx; }.home-button { flex:none; margin:0; padding:0 20rpx; height:62rpx; line-height:62rpx; border-radius:14rpx; background:#ede8de; color:#382c24; font-size:23rpx; }.route-status { padding:22rpx; margin-bottom:22rpx; display:flex; flex-direction:column; gap:14rpx; }.status-head { display:flex; justify-content:space-between; align-items:center; gap:12rpx; }.status-title { color:#7b581b; font-size:27rpx; font-weight:600; }.status-date { color:#8a817b; font-size:20rpx; }.status-copy,.safety-copy { color:#625850; font-size:23rpx; line-height:1.55; }.status-grid { display:flex; flex-wrap:wrap; gap:10rpx; }.status-grid text { padding:7rpx 12rpx; border-radius:8rpx; background:#fff3d9; color:#795c25; font-size:21rpx; }.safety-copy { padding-top:12rpx; border-top:1rpx solid #e6dec8; }
.route-list { display:flex; flex-direction:column; gap:22rpx; }.route-card { padding:28rpx; }.route-head { display:flex; justify-content:space-between; align-items:center; min-height:88rpx; }.route-copy { display:flex; flex-direction:column; gap:8rpx; min-width:0; }.name-row { display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; }.route-name { font-size:36rpx; font-weight:600; }.verify-badge { padding:5rpx 10rpx; border-radius:8rpx; background:#f4e6c8; color:#7b581b; font-size:19rpx; }.theme { color:#4e4540; font-size:25rpx; }.toggle { flex:none; color:#7b581b; font-size:24rpx; }
.meta { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:16rpx; }.meta text { background:#f2ede3; color:#536657; padding:7rpx 12rpx; border-radius:8rpx; font-size:22rpx; }.route-detail { border-top:1rpx solid #e6dec8; margin-top:22rpx; padding-top:20rpx; display:flex; flex-direction:column; gap:16rpx; }.passage-notice { padding:16rpx; border-radius:12rpx; background:#fff7e8; color:#765d35; font-size:22rpx; line-height:1.5; }.stop { display:flex; align-items:center; gap:16rpx; font-size:27rpx; }.number { width:42rpx; height:42rpx; line-height:42rpx; text-align:center; border-radius:50%; background:#382c24; color:#fffaf0; font-size:21rpx; }.map-button { margin:10rpx 0 0; background:#382c24; color:#fffaf0; border-radius:14rpx; font-size:26rpx; }.state { padding:30rpx; display:flex; flex-direction:column; gap:20rpx; }
.offline-notice { margin-bottom:20rpx; padding:20rpx 24rpx; background:#fff4dc; color:#7b581b; border-color:#e3c98e; font-size:23rpx; line-height:1.5; }
.share-route-button { margin:0; background:#fffcf6; color:#7b581b; border:1rpx solid #d8c8aa; border-radius:14rpx; font-size:24rpx; }
