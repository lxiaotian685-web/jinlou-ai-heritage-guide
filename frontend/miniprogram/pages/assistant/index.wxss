@import "../../styles/archive.wxss";

/* ==========================================================================
   答疑 · B 蚝壳青灰
   安静的 FAQ 档案：预设问题网格 + 带来源的答复卡。
   ========================================================================== */

.assistant-page {
  box-sizing: border-box;
  padding: 0 0 calc(56rpx + env(safe-area-inset-bottom));
}

/* ---------- 页头 ---------- */
.faq-head {
  padding: 36rpx 32rpx 0;
}

.faq-head__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.faq-head__folio {
  flex: none;
  font-size: 18rpx;
  line-height: 1.5;
  letter-spacing: 3rpx;
  color: var(--arc-muted);
}

.faq-head__main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 16rpx;
}

.faq-head__copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.faq-head__title {
  font-size: 56rpx;
  line-height: 1.28;
  letter-spacing: 4rpx;
}

.faq-head__seal {
  flex: none;
  margin-top: 4rpx;
}

.faq-head__rule {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 26rpx;
}

.faq-head__rule-line {
  flex: 1;
  height: 1rpx;
  background: var(--arc-line-strong);
}

.faq-head__rule-meta {
  flex: none;
  font-size: 18rpx;
  line-height: 1.5;
  letter-spacing: 3rpx;
  color: var(--arc-muted);
}

/* ---------- 正文 ---------- */
.faq-body {
  padding: 0 32rpx;
}

.faq-section-head {
  margin: 34rpx 0 18rpx;
}

/* ---------- 预设问题网格 ---------- */
.faq-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.faq-question {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  min-height: 96rpx;
  margin: 0;
  padding: 18rpx 20rpx;
  background: var(--arc-cream);
  border: 1rpx solid var(--arc-line);
  border-radius: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  letter-spacing: 0.5rpx;
  text-align: left;
  color: var(--arc-blue);
  transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
}

.faq-question--press {
  background: var(--arc-paper);
  border-color: var(--arc-line-strong);
}

.faq-question.is-active {
  background: var(--arc-ink);
  border-color: var(--arc-ink);
  color: var(--arc-cream);
}

/* ---------- 加载 ---------- */
.faq-loading {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 30rpx 28rpx;
}

.faq-loading__text {
  font-size: 30rpx;
  line-height: 1.5;
  letter-spacing: 2rpx;
  color: var(--arc-ink);
}

.faq-loading__line {
  width: 72rpx;
  height: 2rpx;
  background: var(--arc-red);
  animation: faq-breathe 1.6s ease-in-out infinite;
}

@keyframes faq-breathe {
  0%,
  100% {
    opacity: 0.25;
  }
  50% {
    opacity: 1;
  }
}

/* ---------- 答复卡 ---------- */
.faq-answer {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 24rpx;
  padding: 30rpx 28rpx;
}

.faq-answer__question {
  font-size: 30rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
  color: var(--arc-ink);
}

.faq-answer__tag {
  align-self: flex-start;
  max-width: 100%;
  box-sizing: border-box;
  padding: 6rpx 14rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  line-height: 1.65;
  letter-spacing: 1rpx;
  white-space: normal;
}

.faq-answer__text {
  font-size: 27rpx;
  line-height: 1.8;
  letter-spacing: 0.5rpx;
  color: var(--arc-ink);
}

.faq-answer__hair {
  margin: 8rpx 0 4rpx;
}

.faq-source {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.faq-source__label {
  flex: none;
  width: 200rpx;
  font-size: 20rpx;
  line-height: 1.7;
  letter-spacing: 1rpx;
  color: var(--arc-muted);
}

.faq-source__value {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.7;
  letter-spacing: 0.5rpx;
  color: var(--arc-blue);
  word-break: break-all;
}

/* 错误：蚝壳纸上的一层红，不用粉底材料色 */
.faq-answer.is-error {
  background-color: var(--arc-cream);
  background-image: linear-gradient(rgba(166, 64, 45, 0.07), rgba(166, 64, 45, 0.07));
  border-color: rgba(166, 64, 45, 0.38);
}

.faq-answer.is-error .faq-answer__question,
.faq-answer.is-error .faq-answer__text {
  color: var(--arc-red);
}

.faq-answer.is-error.arc-card--ticks::before,
.faq-answer.is-error.arc-card--ticks::after {
  border-color: var(--arc-red);
}

/* ---------- 空状态 ---------- */
.faq-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  margin-top: 24rpx;
}

.faq-empty__title {
  font-size: 32rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
  color: var(--arc-ink);
}

.faq-empty__text {
  font-size: 24rpx;
  line-height: 1.8;
  letter-spacing: 0.5rpx;
  color: var(--arc-muted);
}

/* ---------- 大字模式 ---------- */
.font-large .faq-head__title {
  font-size: 72rpx;
}

.font-large .faq-head__folio,
.font-large .faq-head__rule-meta {
  font-size: 24rpx;
}

.font-large .faq-question {
  min-height: 116rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
}

.font-large .faq-loading__text {
  font-size: 36rpx;
}

.font-large .faq-answer__question {
  font-size: 38rpx;
}

.font-large .faq-answer__text {
  font-size: 32rpx;
}

.font-large .faq-answer__tag {
  font-size: 26rpx;
}

.font-large .faq-source {
  flex-direction: column;
  gap: 4rpx;
}

.font-large .faq-source__label,
.font-large .faq-source__value {
  width: auto;
  font-size: 26rpx;
}

.font-large .faq-empty__title {
  font-size: 38rpx;
}

.font-large .faq-empty__text {
  font-size: 30rpx;
}

/* ---------- 高对比 ---------- */
.assistant-page.high-contrast {
  background-color: #fff;
  background-image: none;
}

.high-contrast .arc-card,
.high-contrast .arc-empty {
  background: #fff;
  border-color: #393939;
}

.high-contrast .arc-eyebrow,
.high-contrast .arc-lede,
.high-contrast .faq-head__folio,
.high-contrast .faq-head__rule-meta,
.high-contrast .faq-source__label,
.high-contrast .faq-empty__text {
  color: #222;
}

.high-contrast .faq-question {
  background: #fff;
  border-color: #393939;
  color: #111;
}

.high-contrast .faq-question.is-active {
  background: #111;
  border-color: #111;
  color: #fff;
}

.high-contrast .faq-answer__text,
.high-contrast .faq-answer__question,
.high-contrast .faq-empty__title {
  color: #111;
}

.high-contrast .faq-answer__tag {
  border-color: #393939;
  color: #111;
}

.high-contrast .faq-source__value {
  color: #243029;
}

.high-contrast .faq-answer.is-error {
  background: #fff;
  border: 2rpx solid var(--arc-red);
}

.high-contrast .faq-answer.is-error .faq-answer__question,
.high-contrast .faq-answer.is-error .faq-answer__text {
  color: var(--arc-red);
}

@media (prefers-reduced-motion: reduce) {
  .faq-loading__line {
    animation: none;
  }

  .faq-question {
    transition: none;
  }
}
/* ---------- 提问表单 ---------- */
.question-form {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 26rpx 24rpx;
}

.question-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 84rpx;
  padding: 0 20rpx;
  background: var(--arc-paper);
  border: 1rpx solid var(--arc-line);
  border-radius: 8rpx;
  color: var(--arc-ink);
  font-size: 26rpx;
  line-height: 1.5;
}

.form-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--arc-muted);
  font-size: 20rpx;
}

.ask-button,
.retry-button {
  width: auto;
  min-width: 150rpx;
  min-height: 76rpx;
  margin: 0;
  padding: 0 26rpx;
  background: var(--arc-ink);
  border-radius: 6rpx;
  color: var(--arc-cream);
  font-size: 24rpx;
  line-height: 1.5;
}

.ask-button[disabled] {
  opacity: 0.55;
}

.retry-button {
  align-self: flex-start;
  min-width: 0;
  padding: 0 22rpx;
  background: transparent;
  border: 1rpx solid var(--arc-line-strong);
  color: var(--arc-blue);
}

/* ---------- 来源列表 ---------- */
.source-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 6rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--arc-line);
}

.source-heading {
  align-self: flex-start;
  width: auto;
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  color: var(--arc-blue);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1.6;
  text-align: left;
}

.source-heading::after {
  border: none;
}

.source-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 16rpx 18rpx;
  background: var(--arc-paper);
  border-radius: 6rpx;
}

.source-title {
  color: var(--arc-ink);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.6;
}

.source-meta,
.source-scope {
  color: var(--arc-muted);
  font-size: 20rpx;
  line-height: 1.6;
}

.source-link {
  align-self: flex-start;
  width: auto;
  margin: 4rpx 0 0;
  padding: 0 16rpx;
  background: transparent;
  border: 1rpx solid var(--arc-line);
  border-radius: 4rpx;
  color: var(--arc-blue);
  font-size: 20rpx;
  line-height: 52rpx;
}

.sources {
  padding-top: 14rpx;
  border-top: 1rpx solid var(--arc-line);
  color: var(--arc-muted);
  font-size: 20rpx;
  line-height: 1.6;
}

/* ---------- 大字模式补充 ---------- */
.font-large .question-input {
  font-size: 32rpx;
}

.font-large .ask-button,
.font-large .retry-button {
  font-size: 28rpx;
}

.font-large .source-title {
  font-size: 28rpx;
}

.font-large .source-meta,
.font-large .source-scope,
.font-large .sources {
  font-size: 26rpx;
}

/* ---------- 高对比补充 ---------- */
.high-contrast .question-input,
.high-contrast .source-item {
  background: #fff;
  border-color: #393939;
  color: #111;
}

.high-contrast .source-title {
  color: #111;
}
