.assistant-page { height:100vh; overflow:hidden; background:#f6f1e7; }
.content { height:100%; box-sizing:border-box; padding:28rpx 30rpx calc(28rpx + env(safe-area-inset-bottom)); }
.intro { display:flex; flex-direction:column; gap:8rpx; color:#727671; font-size:23rpx; margin-bottom:28rpx; }
.intro .title { color:#382c24; font-size:38rpx; font-weight:600; }
.question-form { margin-bottom:24rpx; padding:20rpx; }
.question-input { min-height:76rpx; box-sizing:border-box; padding:0 18rpx; border:1rpx solid #d8cfbb; border-radius:14rpx; background:#fffdf8; color:#382c24; font-size:26rpx; }
.form-footer { display:flex; align-items:center; justify-content:space-between; margin-top:12rpx; color:#81766f; font-size:21rpx; }
.ask-button, .retry-button { width:auto; min-width:150rpx; margin:0; padding:0 24rpx; border-radius:14rpx; background:#536657; color:#fffaf0; font-size:24rpx; }
.section-label { display:block; margin-bottom:12rpx; color:#7b581b; font-size:23rpx; font-weight:600; }
.question-list { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin-bottom:26rpx; }
.question { width:100%; min-height:90rpx; margin:0; padding:16rpx 18rpx; line-height:1.45; border-radius:18rpx; font-size:24rpx; color:#536657; background:#fffcf6; border:1rpx solid #e6dec8; }
.question.active { color:#fffaf0; background:#536657; border-color:#536657; }
.answer, .tip { box-sizing:border-box; padding:24rpx; color:#382c24; font-size:27rpx; line-height:1.65; display:flex; flex-direction:column; gap:12rpx; }
.answer-question { font-size:30rpx; font-weight:600; }
.data-label { color:#7b581b; font-size:20rpx; }
.error { color:#93000a; background:#ffdad6; }
.sources { padding-top:8rpx; border-top:1rpx solid #e6dec8; color:#727671; font-size:21rpx; }
.source-list { margin-top:4rpx; padding-top:12rpx; border-top:1rpx solid #e6dec8; display:flex; flex-direction:column; gap:12rpx; }
.source-heading { color:#536657; font-size:23rpx; font-weight:600; background:none; border:none; margin:0; padding:0; line-height:1.6; text-align:left; }
.source-heading::after { border:none; }
.source-item { padding:16rpx; border-radius:12rpx; background:#f7f2e8; display:flex; flex-direction:column; gap:6rpx; }
.source-title { color:#382c24; font-size:23rpx; font-weight:600; }
.source-meta, .source-scope { color:#727671; font-size:20rpx; line-height:1.5; }
.source-link { width:auto; margin:6rpx 0 0; padding:0 18rpx; line-height:54rpx; border-radius:10rpx; background:#ede8de; color:#7b581b; font-size:21rpx; }
