<view class="assistant-page {{displayClass}}">
  <scroll-view class="content" scroll-y>
    <view class="intro"><text class="serif title">研学资料问答</text><text>答案优先来自已登记资料，模型只用于整理检索到的内容；资料不足时会明确提示资料库暂未收录，不编造票价、开放时间或历史结论。</text></view>
    <view class="question-form card">
      <input class="question-input" maxlength="200" value="{{inputQuestion}}" placeholder="例如：金楼的木雕有什么特色？" confirm-type="send" bindinput="handleQuestionInput" bindconfirm="submitQuestion" disabled="{{sending}}" />
      <view class="form-footer"><text>{{questionLength}}/200</text><button class="ask-button" bindtap="submitQuestion" loading="{{sending}}" disabled="{{sending}}">提问</button></view>
    </view>
    <text class="section-label">推荐问题</text>
    <view class="question-list">
      <button wx:for="{{quickQuestions}}" wx:key="id" class="question {{selectedQuestion === item.question ? 'active' : ''}}" data-question="{{item.question}}" bindtap="chooseQuickQuestion">{{item.question}}</button>
    </view>
    <view wx:if="{{sending}}" class="answer card muted">正在检索已登记资料…</view>
    <view wx:elif="{{answer}}" class="answer card {{answer.isError ? 'error' : ''}}">
      <text class="answer-question serif">{{selectedQuestion}}</text>
      <text wx:if="{{answer.notice}}" class="data-label">{{answer.notice}}</text>
      <text wx:if="{{answer.modeLabel}}" class="data-label">回答方式：{{answer.modeLabel}}</text>
      <text wx:if="{{answer.fallbackHint}}" class="muted">{{answer.fallbackHint}}</text>
      <text>{{answer.text}}</text>
      <button wx:if="{{answer.canRetry}}" class="retry-button" bindtap="retryLastQuestion">重新尝试</button>
      <view wx:if="{{answer.sources && answer.sources.length}}" class="source-list">
        <button class="source-heading" bindtap="toggleSources">{{sourcesExpanded ? '收起来源' : '查看回答来源（' + answer.sources.length + '）'}}</button>
        <block wx:if="{{sourcesExpanded}}">
        <view wx:for="{{answer.sources}}" wx:key="id" class="source-item">
          <text class="source-title">{{index + 1}}. {{item.title}}</text>
          <text wx:if="{{item.organization}}" class="source-meta">{{item.organization}} · {{item.verificationLabel}}</text>
          <text wx:if="{{item.scope}}" class="source-scope">支持范围：{{item.scope}}</text>
          <button wx:if="{{item.url}}" class="source-link" data-url="{{item.url}}" bindtap="copySourceUrl">复制资料链接</button>
        </view>
        </block>
      </view>
      <text wx:if="{{answer.publicStatus}}" class="sources">公开状态：{{answer.publicStatus}}</text>
    </view>
    <view wx:else class="tip card"><text>可以自由提问</text><text class="muted">系统不会编造票价、开放时间、人物故事或工艺结论；没有可靠资料时会建议人工核对。</text></view>
  </scroll-view>
</view>
