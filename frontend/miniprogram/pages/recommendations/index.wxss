@import "../../styles/archive.wxss";

/* ==========================================================================
   附近推荐 · B 蚝壳青灰
   档案纸、细线、木刻般的留白；朱砂只用于必须被看见的地方。
   ========================================================================== */

.rec-page {
  box-sizing: border-box;
  padding: 44rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
}

.rec-page.high-contrast {
  background-color: #fff;
  background-image: none;
}

.high-contrast .rec-card,
.high-contrast .loading-panel,
.high-contrast .empty-panel,
.high-contrast .rec-sheet {
  background: #fff;
  border-color: #393939;
}

.high-contrast .masthead__source text,
.high-contrast .fact__key,
.high-contrast .card-index,
.high-contrast .card-source,
.high-contrast .card-missing,
.high-contrast .empty-body,
.high-contrast .sheet-fact__key,
.high-contrast .sheet-source,
.high-contrast .a11y-copy__note,
.high-contrast .a11y-eyebrow,
.high-contrast .rec-colophon,
.high-contrast .band-caption,
.high-contrast .demo-caption {
  color: #222;
}

.high-contrast .material-label,
.high-contrast .arc-tag {
  color: #111;
  border-color: #393939;
}

.high-contrast .demo-caption text:last-child {
  color: #222;
}

/* ---------- 刊头 ---------- */
.masthead {
  position: relative;
}

.masthead__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.masthead__stamp {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 18rpx;
  line-height: 1.5;
  letter-spacing: 2rpx;
  color: var(--arc-muted);
}

.masthead__stamp-dot {
  width: 10rpx;
  height: 10rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--arc-red);
  transform: rotate(45deg);
}

.rec-title {
  margin-top: 22rpx;
  font-size: 64rpx;
  line-height: 1.16;
  letter-spacing: 4rpx;
}

.rec-lede {
  margin-top: 14rpx;
}

.masthead__source {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--arc-line);
}

.masthead__source-rule {
  flex: none;
  width: 2rpx;
  align-self: stretch;
  background: var(--arc-red);
  opacity: 0.72;
}

.masthead__source text {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  line-height: 1.75;
  letter-spacing: 1rpx;
  color: var(--arc-muted);
}

/* ---------- 片区影像带 ---------- */
.band {
  margin-top: 30rpx;
}

.band-photo {
  height: 180rpx;
}

.band-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  box-sizing: border-box;
  padding: 34rpx 18rpx 14rpx;
  background: linear-gradient(180deg, rgba(20, 28, 24, 0) 0%, rgba(20, 28, 24, 0.62) 100%);
}

.band-overlay text {
  font-size: 19rpx;
  line-height: 1.5;
  letter-spacing: 2rpx;
  color: var(--arc-cream);
}

.band-overlay__code {
  flex: none;
  opacity: 0.78;
}

.band-caption {
  margin-top: 9rpx;
}

/* ---------- 章节横线 ---------- */
.tabs-head {
  margin-top: 42rpx;
}

.list-head {
  margin-top: 32rpx;
}

/* ---------- 分类索引 ---------- */
.tabs {
  display: flex;
  margin-top: 14rpx;
  border-top: 1rpx solid var(--arc-line);
  border-bottom: 1rpx solid var(--arc-line-strong);
}

.tab {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 20rpx 6rpx 18rpx;
}

.tab + .tab::before {
  content: "";
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 1rpx;
  background: var(--arc-line);
  opacity: 0.72;
}

.tab__label {
  font-family: "Songti SC", "Noto Serif SC", SimSun, serif;
  font-size: 28rpx;
  line-height: 1.3;
  letter-spacing: 3rpx;
  color: var(--arc-muted);
}

.tab__index {
  font-size: 15rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
  color: var(--arc-line-strong);
}

.tab--active .tab__label {
  color: var(--arc-ink);
}

.tab--active .tab__index {
  color: var(--arc-red);
}

.tab--active::after {
  content: "";
  position: absolute;
  left: 22%;
  right: 22%;
  bottom: -1rpx;
  height: 2rpx;
  background: var(--arc-red);
}

/* ---------- 载入 ---------- */
.loading-panel {
  margin-top: 24rpx;
  padding: 34rpx 26rpx;
  background: var(--arc-cream);
  border: 1rpx solid var(--arc-line);
  border-radius: var(--arc-radius);
}

.loading-lines {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.loading-line {
  width: 64%;
  height: 14rpx;
  background: linear-gradient(90deg, var(--arc-paper) 0%, #f8f3e9 50%, var(--arc-paper) 100%);
  background-size: 200% 100%;
  animation: recShimmer 1.6s ease-in-out infinite;
}

.loading-line--wide {
  width: 86%;
}

.loading-line--short {
  width: 42%;
}

.loading-note {
  display: block;
  margin-top: 22rpx;
  font-size: 19rpx;
  line-height: 1.6;
  letter-spacing: 2rpx;
  color: var(--arc-muted);
}

@keyframes recShimmer {
  0% { background-position: 160% 0; }
  100% { background-position: -60% 0; }
}

/* ---------- 读取失败 ---------- */
.error-panel {
  margin-top: 24rpx;
  padding: 44rpx 32rpx 38rpx;
}

.error-code {
  display: block;
  font-size: 17rpx;
  line-height: 1.5;
  letter-spacing: 3rpx;
  color: var(--arc-red);
}

.error-title {
  display: block;
  margin-top: 4rpx;
  font-size: 38rpx;
  line-height: 1.35;
}

.error-body {
  display: block;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--arc-muted);
}

.error-retry {
  width: 100%;
  margin-top: 26rpx;
}

/* ---------- 空状态 ---------- */
.empty-main {
  margin-top: 24rpx;
}

.empty-caption {
  display: block;
  margin-bottom: 10rpx;
  font-size: 18rpx;
  line-height: 1.5;
  letter-spacing: 3rpx;
  color: var(--arc-muted);
}

.empty-panel {
  padding: 44rpx 34rpx 38rpx;
}

.empty-art {
  position: relative;
  width: 132rpx;
  height: 112rpx;
  margin: 0 auto 10rpx;
}

.empty-art__table {
  position: absolute;
  left: 2rpx;
  right: 2rpx;
  bottom: 12rpx;
  height: 1rpx;
  background: var(--arc-line-strong);
}

.empty-art__plate {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 10rpx;
  height: 82rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--arc-line-strong);
  border-radius: 50%;
}

.empty-art__ring {
  position: absolute;
  left: 42rpx;
  right: 42rpx;
  top: 34rpx;
  height: 34rpx;
  box-sizing: border-box;
  border: 1rpx dashed var(--arc-line-strong);
  border-radius: 50%;
}

.empty-art__chop {
  position: absolute;
  right: 6rpx;
  width: 70rpx;
  height: 1rpx;
  background: var(--arc-line-strong);
}

.empty-art__chop--a {
  top: 24rpx;
  transform: rotate(-16deg);
}

.empty-art__chop--b {
  top: 34rpx;
  right: 10rpx;
  transform: rotate(-10deg);
}

.empty-title {
  display: block;
  margin-top: 2rpx;
  font-size: 38rpx;
  line-height: 1.38;
  letter-spacing: 1rpx;
}

.empty-body {
  display: block;
  max-width: 560rpx;
  margin: 0 auto;
  font-size: 23rpx;
  line-height: 1.85;
  color: var(--arc-muted);
}

.empty-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 28rpx;
}

.empty-actions button {
  flex: 1 1 240rpx;
  width: auto;
  padding: 0 14rpx;
}

/* ---------- 推荐条目 ---------- */
.rec-list {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  margin-top: 24rpx;
}

.rec-card {
  padding: 14rpx;
}

.card-media {
  height: 236rpx;
  overflow: hidden;
  border-radius: 2rpx;
}

.card-media::before {
  content: "";
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  z-index: 2;
  width: 24rpx;
  height: 24rpx;
  border-top: 1rpx solid rgba(36, 48, 41, 0.32);
  border-left: 1rpx solid rgba(36, 48, 41, 0.32);
  pointer-events: none;
}

.card-image {
  display: block;
  width: 100%;
  height: 100%;
}

/* 材质替代图：细密织纹 + 纸面渐变，明确不是商户照片 */
.material {
  background-color: var(--arc-paper);
  background-image: linear-gradient(135deg, #ece6da 0%, #ded7c8 52%, #e9e3d6 100%);
  background-image:
    repeating-linear-gradient(0deg, rgba(36, 48, 41, 0.07) 0, rgba(36, 48, 41, 0.07) 1rpx, transparent 1rpx, transparent 9rpx),
    repeating-linear-gradient(90deg, rgba(36, 48, 41, 0.05) 0, rgba(36, 48, 41, 0.05) 1rpx, transparent 1rpx, transparent 9rpx),
    repeating-linear-gradient(45deg, rgba(250, 246, 238, 0.42) 0, rgba(250, 246, 238, 0.42) 1rpx, transparent 1rpx, transparent 18rpx),
    radial-gradient(circle at 24% 18%, rgba(250, 246, 238, 0.9), rgba(250, 246, 238, 0) 58%),
    linear-gradient(135deg, #ece6da 0%, #ded7c8 52%, #e9e3d6 100%);
}

.material--food {
  background-color: #e8e1d3;
}

.material--hotel {
  background-color: #e4ded2;
}

.material--transport {
  background-color: #e6e0d4;
}

.material--attraction {
  background-color: #e1dccf;
}

.glyph {
  position: absolute;
  left: 50%;
  top: 46%;
  width: 160rpx;
  height: 100rpx;
  transform: translate(-50%, -50%);
  opacity: 0.62;
  pointer-events: none;
}

/* 美食：碗、桌面、两缕热气 */
.glyph--food .g-bowl {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: 22rpx;
  height: 42rpx;
  border: 1rpx solid var(--arc-blue);
  border-top: 0;
  border-radius: 0 0 80rpx 80rpx / 0 0 54rpx 54rpx;
}

.glyph--food .g-table {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  bottom: 18rpx;
  height: 1rpx;
  background: var(--arc-blue);
}

.glyph--food .g-steam {
  position: absolute;
  width: 16rpx;
  height: 32rpx;
  border-left: 1rpx solid var(--arc-blue);
  border-radius: 50%;
}

.glyph--food .g-steam--a {
  left: 58rpx;
  bottom: 72rpx;
  transform: rotate(6deg);
}

.glyph--food .g-steam--b {
  left: 86rpx;
  bottom: 74rpx;
  height: 38rpx;
  transform: rotate(-8deg);
}

/* 酒店：床头、床垫、枕头 */
.glyph--hotel .g-head {
  position: absolute;
  left: 30rpx;
  top: 24rpx;
  bottom: 26rpx;
  width: 1rpx;
  background: var(--arc-blue);
}

.glyph--hotel .g-mattress {
  position: absolute;
  left: 30rpx;
  right: 24rpx;
  bottom: 58rpx;
  height: 1rpx;
  background: var(--arc-blue);
}

.glyph--hotel .g-pillow {
  position: absolute;
  left: 40rpx;
  bottom: 58rpx;
  width: 42rpx;
  height: 16rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--arc-blue);
  border-radius: 2rpx;
}

.glyph--hotel .g-bed {
  position: absolute;
  left: 30rpx;
  right: 24rpx;
  bottom: 26rpx;
  height: 32rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--arc-blue);
  border-top: 0;
}

.glyph--hotel .g-leg {
  position: absolute;
  bottom: 16rpx;
  width: 1rpx;
  height: 10rpx;
  background: var(--arc-blue);
}

.glyph--hotel .g-leg--a {
  left: 34rpx;
}

.glyph--hotel .g-leg--b {
  right: 28rpx;
}

/* 交通：虚线路线、两个端点、方向箭头 */
.glyph--transport .g-route {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  top: 52rpx;
  height: 1rpx;
  background: repeating-linear-gradient(90deg, rgba(92, 107, 102, 0.8) 0, rgba(92, 107, 102, 0.8) 10rpx, transparent 10rpx, transparent 22rpx);
}

.glyph--transport .g-pin {
  position: absolute;
  top: 45rpx;
  width: 14rpx;
  height: 14rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--arc-blue);
  border-radius: 50%;
  background: rgba(250, 246, 238, 0.86);
}

.glyph--transport .g-pin--a {
  left: 8rpx;
}

.glyph--transport .g-pin--b {
  right: 8rpx;
  border-color: rgba(166, 64, 45, 0.58);
}

.glyph--transport .g-arrow {
  position: absolute;
  left: 50%;
  top: 47rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 1rpx solid var(--arc-blue);
  border-right: 1rpx solid var(--arc-blue);
  transform: translateX(-50%) rotate(45deg);
}

.glyph--transport .g-tick {
  position: absolute;
  top: 34rpx;
  width: 1rpx;
  height: 8rpx;
  background: var(--arc-blue);
}

.glyph--transport .g-tick--a {
  left: 50rpx;
}

.glyph--transport .g-tick--b {
  left: 79rpx;
}

.glyph--transport .g-tick--c {
  right: 50rpx;
}

/* 景点：檐口、脊线、两根立柱 */
.glyph--attraction .g-roof {
  position: absolute;
  top: 38rpx;
  width: 64rpx;
  height: 1rpx;
  background: var(--arc-blue);
}

.glyph--attraction .g-roof--l {
  left: 10rpx;
  transform: rotate(-16deg);
  transform-origin: right center;
}

.glyph--attraction .g-roof--r {
  right: 10rpx;
  transform: rotate(16deg);
  transform-origin: left center;
}

.glyph--attraction .g-ridge {
  position: absolute;
  left: 50%;
  top: 14rpx;
  width: 1rpx;
  height: 26rpx;
  background: var(--arc-blue);
  transform: translateX(-50%);
}

.glyph--attraction .g-pillar {
  position: absolute;
  top: 44rpx;
  bottom: 22rpx;
  width: 1rpx;
  background: var(--arc-blue);
}

.glyph--attraction .g-pillar--l {
  left: 44rpx;
}

.glyph--attraction .g-pillar--r {
  right: 44rpx;
}

.glyph--attraction .g-base {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 18rpx;
  height: 1rpx;
  background: var(--arc-blue);
}

.material-code {
  position: absolute;
  right: 18rpx;
  top: 16rpx;
  z-index: 3;
  font-size: 16rpx;
  line-height: 1.5;
  letter-spacing: 2rpx;
  color: rgba(36, 48, 41, 0.48);
}

.material-label {
  position: absolute;
  left: 18rpx;
  bottom: 16rpx;
  z-index: 3;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 7rpx 12rpx;
  background: rgba(250, 246, 238, 0.9);
  border: 1rpx solid rgba(185, 179, 165, 0.9);
  font-size: 20rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
  color: var(--arc-blue);
}

.material-label__mark {
  flex: none;
  width: 7rpx;
  height: 7rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--arc-red);
  transform: rotate(45deg);
}

.media-num {
  right: 14rpx;
  bottom: -26rpx;
  z-index: 1;
  font-size: 170rpx;
  color: rgba(36, 48, 41, 0.09);
}

/* ---------- 条目正文 ---------- */
.card-body {
  position: relative;
  z-index: 2;
  padding: 6rpx 8rpx 10rpx;
}

.card-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx 12rpx;
  margin-top: 16rpx;
}

.card-index {
  margin-left: auto;
  font-size: 17rpx;
  line-height: 1.5;
  letter-spacing: 2rpx;
  color: var(--arc-muted);
}

.card-name {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
  line-height: 1.34;
  letter-spacing: 1rpx;
  color: var(--arc-ink);
}

.card-facts {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 16rpx;
}

.fact {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
}

.fact__key {
  flex: none;
  width: 66rpx;
  padding-top: 4rpx;
  font-size: 18rpx;
  line-height: 1.6;
  letter-spacing: 2rpx;
  color: var(--arc-muted);
}

.fact__val {
  flex: 1;
  min-width: 0;
  color: var(--arc-ink);
  word-break: break-all;
}

.card-missing {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--arc-muted);
}

.card-desc {
  display: block;
  margin-top: 16rpx;
  padding-left: 16rpx;
  border-left: 2rpx solid var(--arc-line-strong);
  font-size: 23rpx;
  line-height: 1.8;
  color: var(--arc-blue);
}

.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 14rpx 18rpx;
  margin-top: 20rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--arc-line);
}

.card-source {
  flex: 1;
  min-width: 300rpx;
  font-size: 18rpx;
  line-height: 1.6;
  letter-spacing: 1rpx;
  color: var(--arc-muted);
}

.card-actions {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-left: auto;
}

.link-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: auto;
  min-height: 0;
  margin: 0;
  padding: 12rpx 0 10rpx;
  border-radius: 0;
  border-bottom: 1rpx solid var(--arc-line-strong);
  background: transparent;
  color: var(--arc-ink);
  font-size: 21rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
}

.link-btn--quiet {
  border-bottom-color: transparent;
  color: var(--arc-muted);
}

/* ---------- 空状态演示 ---------- */
.demo-block {
  margin-top: 48rpx;
}

.demo-head {
  margin-top: 0;
}

.demo-caption {
  margin: 12rpx 0 10rpx;
}

.demo-caption text:last-child {
  color: var(--arc-line-strong);
}

/* ---------- 阅读辅助 ---------- */
.a11y-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx 20rpx;
  margin-top: 52rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--arc-line-strong);
}

.a11y-eyebrow {
  display: block;
  font-size: 18rpx;
  line-height: 1.5;
  letter-spacing: 3rpx;
  color: var(--arc-muted);
}

.a11y-copy__note {
  display: block;
  margin-top: 6rpx;
  font-size: 19rpx;
  line-height: 1.5;
  color: var(--arc-muted);
}

.a11y-pill {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-left: auto;
  padding: 10rpx 14rpx 10rpx 26rpx;
  border: 1rpx solid var(--arc-line-strong);
  border-radius: 999rpx;
  background: rgba(250, 246, 238, 0.82);
}

.a11y-pill--hover {
  background: var(--arc-cream);
}

.a11y-pill__copy {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 1rpx;
}

.a11y-pill__title {
  font-family: "Songti SC", "Noto Serif SC", SimSun, serif;
  font-size: 26rpx;
  line-height: 1.3;
  letter-spacing: 2rpx;
  color: var(--arc-ink);
}

.a11y-pill__note {
  font-size: 20rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
  color: var(--arc-muted);
}

.a11y-switch {
  position: relative;
  flex: none;
  width: 70rpx;
  height: 38rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--arc-line-strong);
  border-radius: 999rpx;
  background: var(--arc-paper);
  transition: background-color 0.2s ease, border-color 0.2s ease;
}

.a11y-switch__knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--arc-line-strong);
  border-radius: 50%;
  background: var(--arc-cream);
  transition: transform 0.2s ease;
}

.a11y-pill.is-on {
  border-color: var(--arc-ink);
}

.a11y-pill.is-on .a11y-switch {
  background: var(--arc-ink);
  border-color: var(--arc-ink);
}

.a11y-pill.is-on .a11y-switch__knob {
  transform: translateX(32rpx);
  border-color: var(--arc-ink);
}

/* ---------- 页脚 ---------- */
.rec-colophon {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 26rpx;
  padding-bottom: 6rpx;
  font-size: 16rpx;
  line-height: 1.5;
  letter-spacing: 2rpx;
  color: var(--arc-muted);
  opacity: 0.8;
}

.rec-colophon__line {
  flex: 1;
  height: 1rpx;
  background: var(--arc-line);
}

/* ---------- 详情弹层 ---------- */
.rec-sheet {
  display: flex;
  flex-direction: column;
  max-height: 1180rpx;
}

.sheet-head {
  padding: 4rpx 0 18rpx;
  border-bottom: 1rpx solid var(--arc-line);
}

.sheet-kicker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 14rpx;
}

.sheet-title {
  display: block;
  margin-top: 12rpx;
  font-size: 44rpx;
  line-height: 1.32;
  letter-spacing: 1rpx;
  color: var(--arc-ink);
}

.sheet-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.sheet-tags__file {
  margin-left: auto;
  font-size: 16rpx;
  line-height: 1.5;
  letter-spacing: 2rpx;
  color: var(--arc-muted);
}

.sheet-scroll {
  max-height: 620rpx;
  margin-top: 18rpx;
}

.sheet-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.85;
  color: var(--arc-blue);
}

.sheet-facts {
  margin-top: 20rpx;
  border-top: 1rpx solid var(--arc-line);
}

.sheet-fact {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--arc-line);
}

.sheet-fact__key {
  flex: none;
  width: 110rpx;
  font-size: 18rpx;
  line-height: 1.7;
  letter-spacing: 2rpx;
  color: var(--arc-muted);
}

.sheet-fact__val {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--arc-ink);
  word-break: break-all;
}

.sheet-source {
  display: block;
  margin-top: 18rpx;
  font-size: 18rpx;
  line-height: 1.6;
  letter-spacing: 1rpx;
  color: var(--arc-muted);
}

.sheet-actions {
  padding-top: 18rpx;
  border-top: 1rpx solid var(--arc-line-strong);
}

.sheet-actions__row {
  display: flex;
  gap: 12rpx;
}

.sheet-actions__row .arc-btn {
  flex: 1;
  width: auto;
  min-width: 0;
  padding: 0 10rpx;
}

.sheet-back {
  width: 100%;
  margin-top: 12rpx;
}

