.heading { display:flex; flex-direction:column; gap:10rpx; margin-bottom:28rpx; }.heading .muted,.content .muted { font-size:24rpx; }
.list { display:flex; flex-direction:column; gap:24rpx; }.recommendation image { width:100%; height:300rpx; }.content { padding:26rpx; display:flex; flex-direction:column; gap:12rpx; }
.type { color:#7b581b; font-size:22rpx; }.name { font-size:34rpx; font-weight:600; }.actions { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; margin-top:12rpx; }.actions button { margin:0; font-size:25rpx; background:#f2ede3; color:#382c24; }
.state { padding:30rpx; display:flex; flex-direction:column; gap:20rpx; }.mask { position:fixed; inset:0; background:rgba(34,24,16,.45); display:flex; align-items:flex-end; z-index:10; }.sheet { width:100%; box-sizing:border-box; background:#fffcf6; padding:36rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius:30rpx 30rpx 0 0; display:flex; flex-direction:column; gap:22rpx; }.sheet-title { font-size:36rpx; font-weight:600; }
