.heading { display:flex; flex-direction:column; gap:10rpx; margin-bottom:24rpx; }.heading .muted { font-size:23rpx; line-height:1.5; }.data-list { padding:0 24rpx; }.row { display:flex; align-items:center; justify-content:space-between; gap:20rpx; padding:24rpx 0; border-bottom:1rpx solid #e6dec8; }.row:last-child { border-bottom:0; }.row>view { display:flex; flex-direction:column; gap:6rpx; font-size:27rpx; }.row>view text:last-child { color:#81766f; font-size:21rpx; }.row button { flex:none; width:auto; margin:0; padding:0 18rpx; line-height:58rpx; background:#f2ede3; color:#7b581b; border-radius:10rpx; font-size:21rpx; }.policy { margin-top:22rpx; padding:28rpx; display:flex; flex-direction:column; gap:16rpx; color:#5f5550; font-size:24rpx; line-height:1.7; }.policy-title { color:#382c24; font-size:32rpx; font-weight:600; }
.admin-entry { margin-top:28rpx; background:transparent; color:#81766f; font-size:22rpx; }
