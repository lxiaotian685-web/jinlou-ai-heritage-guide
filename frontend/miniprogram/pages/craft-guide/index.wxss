.state { padding: 32rpx; margin: 32rpx; display: flex; flex-direction: column; gap: 24rpx; }
.heading { display: flex; flex-direction: column; gap: 18rpx; padding-bottom: 30rpx; }
.eyebrow { color: #8a6a2b; font-size: 24rpx; letter-spacing: 2rpx; }
.title { font-size: 50rpx; font-weight: 600; }
.summary { color: #5d534c; font-size: 27rpx; line-height: 1.7; }
.diagram { position: relative; height: 480rpx; overflow: hidden; }
.diagram image { width: 100%; height: 100%; }
.diagram-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(24, 18, 13, 0.08), rgba(24, 18, 13, 0.52)); }
.focus-ring { position: absolute; left: 46%; top: 36%; width: 92rpx; height: 92rpx; border: 4rpx solid #ead596; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fffaf0; background: rgba(56, 44, 36, 0.72); font-size: 34rpx; }
.diagram-label { position: absolute; left: 32rpx; bottom: 26rpx; color: #fffaf0; font-size: 24rpx; }
.step-tabs { display: flex; gap: 18rpx; margin-bottom: 22rpx; }
.step-tab { width: 72rpx; height: 72rpx; line-height: 72rpx; margin: 0; padding: 0; border-radius: 50%; background: #e9e1d2; color: #6e625a; font-size: 26rpx; }
.step-tab.active { background: #382c24; color: #fffaf0; }
.step-card { padding: 30rpx; display: flex; flex-direction: column; gap: 16rpx; }
.step-index { color: #8a6a2b; font-size: 23rpx; }
.step-title { font-size: 34rpx; font-weight: 600; }
.step-description { color: #554b45; font-size: 27rpx; line-height: 1.75; }
.model-button { margin: 26rpx 0 0; background: #ede8de; color: #7b581b; border-radius: 16rpx; font-size: 27rpx; }
.notice { margin-top: 20rpx; color: #7a716b; font-size: 24rpx; line-height: 1.6; text-align: center; }
