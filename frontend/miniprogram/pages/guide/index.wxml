<view class="page section {{displayClass}}">
  <view class="heading">
    <text class="section-title serif">园区导览</text>
    <text class="muted">手绘布局示意 · 不作为现场导航</text>
  </view>
  <view wx:if="{{offlineNotice}}" class="offline-notice card">{{offlineNotice}}</view>
  <view class="map card">
    <image class="map-art" src="/images/bijiang-handdrawn-map-v1.jpg" mode="aspectFit" />
    <view class="map-wash"></view>
    <canvas id="routeCanvas" type="2d" class="route-canvas"></canvas>
    <text class="map-label serif">手绘示意图</text>
    <text wx:if="{{selectedRoute}}" class="route-badge">游线预览</text>
    <block wx:if="{{selectedRoute}}">
      <view wx:for="{{routeDisplayPoints}}" wx:key="number" class="poi route-poi {{item.isVisited ? 'visited' : ''}} {{item.isCurrent ? 'current' : ''}}" style="left:{{item.positionX}}%;top:{{item.positionY}}%;" data-number="{{item.siteNumber}}" bindtap="selectPoint">
        <text class="poi-number">{{item.number}}</text><text>{{item.name}}</text>
      </view>
    </block>
    <block wx:else>
      <view wx:for="{{sitePoints}}" wx:key="number" class="site-dot" style="left:{{item.positionX}}%;top:{{item.positionY}}%;" data-number="{{item.number}}" bindtap="selectPoint">{{item.number}}</view>
    </block>
  </view>
  <view class="notice card">{{mapNotice || '正在读取现场景点分布…'}}</view>
  <view wx:if="{{mapMeta}}" class="map-status card">
    <text class="map-status-title">地图资料状态</text>
    <view class="map-status-tags"><text>官方高清图：待提供</text><text>入口出口：待确认</text><text>无障碍通道：待确认</text></view>
    <text class="map-source">点位依据：{{mapMeta.source}}；核对至 {{mapMeta.lastReviewed}}</text>
  </view>
  <view wx:if="{{activePoint}}" class="point-sheet card">
    <view class="point-copy"><text class="point-sheet-number">景点 {{activePoint.number}}</text><text class="point-sheet-name serif">{{activePoint.name}}</text></view>
    <view class="point-actions">
      <button class="clear-button" bindtap="clearPoint">关闭</button>
      <button class="point-detail-button" bindtap="openPointSpot">查看景点</button>
    </view>
  </view>
  <view wx:if="{{sitePoints.length}}" class="point-list card">
    <view wx:for="{{sitePoints}}" wx:key="number" class="point-item"><text class="point-number">{{item.number}}</text><text>{{item.name}}</text></view>
  </view>
  <view wx:if="{{selectedRoute}}" class="selected-route card">
    <view class="selected-head">
      <view class="selected-copy">
        <text class="selected-label">当前推荐游线</text>
        <text class="selected-name serif">{{selectedRoute.name}}</text>
        <text class="selected-theme">{{selectedRoute.theme}}</text>
      </view>
      <button class="clear-button" bindtap="clearRoute">清除</button>
    </view>
    <view wx:if="{{routeProgress}}" class="route-progress">
      <view class="progress-head"><text>路线进度</text><text>{{routeProgress.completedCount}} / {{routeProgress.totalCount}}</text></view>
      <view class="progress-track"><view class="progress-value" style="width:{{routeProgress.progressPercent}}%;"></view></view>
      <view wx:if="{{routeProgress.isComplete}}" class="route-complete">
        <text class="complete-title serif">这条路线已全部游览</text>
        <text>你可以选择另一条推荐路线继续探索。</text>
      </view>
      <view wx:else class="route-now">
        <view class="now-copy">
          <text class="now-label">当前站</text>
          <text class="now-name serif">{{routeProgress.currentStop.name}}</text>
          <text class="next-stop">下一站：{{routeProgress.nextStop ? routeProgress.nextStop.name : '本路线终点'}}</text>
        </view>
        <button class="current-button" bindtap="openCurrentStop">查看当前站</button>
      </view>
    </view>
    <view class="selected-stops">
      <view wx:for="{{routeDisplayPoints}}" wx:key="number" class="selected-stop {{item.isVisited ? 'visited' : ''}} {{item.isCurrent ? 'current' : ''}}">
        <text class="stop-number">{{item.number}}</text>
        <text class="stop-name">{{item.name}}</text>
        <text class="stop-status">{{item.isVisited ? '已完成' : (item.isCurrent ? '当前站' : '待游览')}}</text>
      </view>
    </view>
    <text class="selected-notice">编号不代表游览顺序；路线为资料参考，须景区确认和现场实走</text>
  </view>
  <button class="primary-button" bindtap="openSpots">查看全部景点</button>
  <button class="route-button" bindtap="openRoutes">查看推荐游线</button>
</view>
