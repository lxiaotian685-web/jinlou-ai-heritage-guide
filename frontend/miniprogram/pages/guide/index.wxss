@import "../../styles/archive.wxss";

/* ==========================================================================
   导览 · B 蚝壳青灰
   墨色页头 + 档案图版；点位保持原有百分比坐标与事件绑定。
   ========================================================================== */

.guide-page {
  box-sizing: border-box;
  padding: 0 32rpx calc(52rpx + env(safe-area-inset-bottom));
}

/* ---------- 墨色页头 ---------- */
.guide-head {
  position: relative;
  margin: 0 -32rpx;
  padding: 42rpx 36rpx 32rpx;
  background-color: var(--arc-ink);
  background-image: linear-gradient(158deg, rgba(250, 246, 238, 0.08), rgba(250, 246, 238, 0) 62%);
  color: var(--arc-cream);
  overflow: hidden;
}

.guide-head__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.guide-head__eyebrow {
  color: rgba(250, 246, 238, 0.56);
}

.guide-head__folio {
  flex: none;
  font-size: 18rpx;
  line-height: 1.5;
  letter-spacing: 3rpx;
  color: rgba(250, 246, 238, 0.56);
}

.guide-head__main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 18rpx;
}

.guide-head__copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.guide-head__title {
  font-size: 66rpx;
  line-height: 1.2;
  letter-spacing: 6rpx;
  color: var(--arc-cream);
}

.guide-head__lede {
  display: block;
  font-size: 23rpx;
  line-height: 1.8;
  letter-spacing: 1rpx;
  color: rgba(250, 246, 238, 0.64);
}

.guide-head__seal {
  flex: none;
  width: 80rpx;
  height: 80rpx;
  margin-top: 6rpx;
  border-color: rgba(250, 246, 238, 0.56);
  box-shadow: inset 0 0 0 4rpx var(--arc-ink), inset 0 0 0 5rpx rgba(250, 246, 238, 0.5);
  color: rgba(250, 246, 238, 0.86);
  font-size: 21rpx;
}

.guide-head__rule {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 26rpx;
}

.guide-head__rule-line {
  flex: 1;
  height: 1rpx;
  background: rgba(250, 246, 238, 0.2);
}

.guide-head__rule-meta {
  flex: none;
  font-size: 18rpx;
  line-height: 1.5;
  letter-spacing: 3rpx;
  color: rgba(250, 246, 238, 0.56);
}

.guide-body {
  padding-top: 28rpx;
}

/* ---------- 离线提示 ---------- */
.guide-offline {
  margin-bottom: 22rpx;
  padding: 16rpx 20rpx;
  background: var(--arc-cream);
  border: 1rpx solid var(--arc-line);
  border-left: 3rpx solid var(--arc-red);
  border-radius: 4rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--arc-blue);
}

/* ---------- 手绘图版 ---------- */
.map-plate {
  position: relative;
  margin: 0 -10rpx;
  padding: 10rpx;
  background: var(--arc-cream);
  border: 1rpx solid var(--arc-line-strong);
}

.map-plate::before,
.map-plate::after {
  content: "";
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  pointer-events: none;
}

.map-plate::before {
  top: -7rpx;
  left: -7rpx;
  border-top: 2rpx solid var(--arc-red);
  border-left: 2rpx solid var(--arc-red);
}

.map-plate::after {
  right: -7rpx;
  bottom: -7rpx;
  border-right: 2rpx solid var(--arc-red);
  border-bottom: 2rpx solid var(--arc-red);
}

.map-plate__inner {
  position: relative;
  box-sizing: border-box;
  height: 686rpx;
  overflow: hidden;
  background: var(--arc-paper);
  border: 1rpx solid var(--arc-line);
}

.map-art {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
}

.map-wash {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  background: rgba(250, 246, 238, 0.08);
}

.route-canvas {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.map-label {
  position: absolute;
  top: 22rpx;
  left: 22rpx;
  z-index: 5;
  padding: 6rpx 14rpx;
  background: rgba(250, 246, 238, 0.94);
  border: 1rpx solid var(--arc-line-strong);
  border-radius: 2rpx;
  font-size: 23rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
  color: var(--arc-ink);
}

.route-badge {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  z-index: 5;
  padding: 7rpx 13rpx;
  background: var(--arc-ink);
  border: 1rpx solid rgba(250, 246, 238, 0.28);
  border-radius: 2rpx;
  font-size: 18rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
  color: var(--arc-cream);
}

.map-caption {
  margin-top: 9rpx;
  padding: 0 2rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: var(--arc-blue);
}

.map-caption text:last-child {
  color: var(--arc-muted);
}

/* ---------- 点位标记 ---------- */
.site-dot {
  position: absolute;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 42rpx;
  height: 42rpx;
  transform: translate(-50%, -50%);
  border: 2rpx solid rgba(250, 246, 238, 0.92);
  border-radius: 50%;
  background: var(--arc-ink);
  box-shadow: 0 4rpx 14rpx rgba(20, 28, 24, 0.32);
  font-family: "Songti SC", "Noto Serif SC", SimSun, serif;
  font-size: 18rpx;
  line-height: 1;
  color: var(--arc-cream);
}

/* 可见圆点 42rpx，实际触控区扩到 82rpx，避免地图点位难以点中。 */
.site-dot::after {
  content: "";
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  bottom: -20rpx;
  left: -20rpx;
}

.site-dot--press {
  background: var(--arc-red);
}

.route-poi--press {
  opacity: 0.88;
}

.poi {
  position: absolute;
}

.route-poi {
  position: absolute;
  z-index: 5;
  display: flex;
  align-items: center;
  gap: 6rpx;
  box-sizing: border-box;
  min-width: 0;
  max-width: 190rpx;
  padding: 5rpx 10rpx 5rpx 5rpx;
  transform: translate(-50%, -50%);
  background: var(--arc-ink);
  border: 1rpx solid rgba(250, 246, 238, 0.3);
  border-radius: 4rpx;
  box-shadow: 0 6rpx 16rpx rgba(20, 28, 24, 0.26);
  font-size: 18rpx;
  line-height: 1.25;
  color: var(--arc-cream);
}

.route-poi text:last-child {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 游线点位加一层透明触控边距，视觉不变，点按更容易。 */
.route-poi::after {
  content: "";
  position: absolute;
  top: -14rpx;
  right: -10rpx;
  bottom: -14rpx;
  left: -10rpx;
}

.poi-number {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(250, 246, 238, 0.92);
  font-size: 18rpx;
  line-height: 1;
  color: var(--arc-ink);
}

.route-poi.visited {
  background: var(--arc-blue);
  border-color: rgba(250, 246, 238, 0.22);
}

.route-poi.current {
  background: var(--arc-red);
  border-color: rgba(250, 246, 238, 0.55);
  box-shadow: 0 0 0 5rpx rgba(166, 64, 45, 0.18), 0 6rpx 16rpx rgba(20, 28, 24, 0.3);
}

.route-poi.current .poi-number {
  background: var(--arc-cream);
  color: var(--arc-red);
}

/* ---------- 点位说明 ---------- */
.guide-notice {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 20rpx;
  padding: 0 2rpx;
}

.guide-notice__mark {
  flex: none;
  width: 2rpx;
  height: 22rpx;
  margin-top: 6rpx;
  background: var(--arc-red);
  opacity: 0.8;
}

.guide-notice__text {
  flex: 1;
  min-width: 0;
  font-size: 21rpx;
  line-height: 1.75;
  letter-spacing: 1rpx;
  color: var(--arc-muted);
}

/* ---------- 章节头 ---------- */
.guide-heading {
  margin: 40rpx 0 18rpx;
}

/* ---------- 选中点位 ---------- */
.point-sheet {
  margin-bottom: 22rpx;
  padding: 24rpx 24rpx 20rpx;
}

.point-sheet__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.point-sheet__name {
  display: block;
  margin-top: 10rpx;
  font-size: 42rpx;
  line-height: 1.35;
  letter-spacing: 1rpx;
  color: var(--arc-ink);
}

.point-sheet__hair {
  margin: 18rpx 0;
}

.point-sheet__foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
}

.point-sheet__note {
  flex: 1;
  min-width: 0;
  font-size: 19rpx;
  line-height: 1.6;
  letter-spacing: 1rpx;
  color: var(--arc-muted);
}

.point-sheet__open {
  flex: none;
  width: auto;
  min-height: 88rpx;
  padding: 0 22rpx;
  font-size: 23rpx;
}

.text-btn {
  flex: none;
  display: inline-flex;
  align-items: flex-end;
  width: auto;
  min-height: 64rpx;
  margin: 0;
  padding: 0 4rpx 8rpx;
  border: 0;
  border-bottom: 1rpx solid var(--arc-line-strong);
  border-radius: 0;
  background: transparent;
  font-size: 21rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
  color: var(--arc-blue);
}

/* ---------- 点位索引 ---------- */
.point-list {
  margin-bottom: 22rpx;
  padding: 24rpx;
}

.point-list__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.point-list__count {
  flex: none;
  font-size: 19rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
  color: var(--arc-muted);
}

.point-list__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rpx 26rpx;
  margin-top: 14rpx;
}

.point-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  min-height: 64rpx;
  padding: 6rpx 0;
}

.point-item--press {
  background: var(--arc-paper);
}

.point-number {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--arc-line-strong);
  border-radius: 50%;
  font-size: 18rpx;
  line-height: 1;
  color: var(--arc-blue);
}

.point-name {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--arc-ink);
}

/* ---------- 地图资料状态 ---------- */
.map-status {
  margin-bottom: 22rpx;
  padding: 24rpx;
}

.map-status__head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 14rpx;
}

.map-status__title {
  font-size: 30rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
  color: var(--arc-ink);
}

.map-status__rows {
  margin: 2rpx 0;
}

.map-status__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  padding: 11rpx 0;
  font-size: 22rpx;
  line-height: 1.6;
}

.map-status__row + .map-status__row {
  border-top: 1rpx solid var(--arc-line);
}

.map-status__key {
  flex: none;
  letter-spacing: 1rpx;
  color: var(--arc-muted);
}

.map-status__val {
  flex: 1;
  min-width: 0;
  text-align: right;
  color: var(--arc-ink);
}

.map-status__source {
  display: block;
  margin-top: 14rpx;
  font-size: 20rpx;
  line-height: 1.7;
  letter-spacing: 0.5rpx;
  color: var(--arc-muted);
}

/* ---------- 当前游线 ---------- */
.selected-route {
  position: relative;
  margin-bottom: 22rpx;
  padding: 26rpx;
  overflow: hidden;
}

.selected-route__ghost {
  right: 10rpx;
  bottom: -22rpx;
  font-size: 150rpx;
  color: rgba(36, 48, 41, 0.05);
}

.selected-head {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.selected-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.selected-name {
  font-size: 40rpx;
  line-height: 1.35;
  letter-spacing: 1rpx;
  color: var(--arc-ink);
}

.selected-theme {
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--arc-blue);
}

.route-progress {
  position: relative;
  z-index: 2;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--arc-line);
}

.progress-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.progress-label {
  font-size: 20rpx;
  line-height: 1.6;
  letter-spacing: 2rpx;
  color: var(--arc-muted);
}

.progress-nums {
  display: flex;
  flex: none;
  align-items: baseline;
  gap: 6rpx;
}

.progress-completed {
  font-size: 44rpx;
  line-height: 1;
  color: var(--arc-ink);
}

.progress-total {
  font-size: 24rpx;
  line-height: 1.2;
  color: var(--arc-muted);
}

.progress-track {
  position: relative;
  height: 3rpx;
  margin-top: 14rpx;
  background: var(--arc-line);
}

.progress-value {
  position: relative;
  height: 3rpx;
  background: var(--arc-red);
  transition: width 200ms ease;
}

.progress-value::after {
  content: "";
  position: absolute;
  top: -3rpx;
  right: -3rpx;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: var(--arc-red);
}

.route-now {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 26rpx;
  padding-top: 0;
}

.now-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.now-label {
  font-size: 20rpx;
  line-height: 1.5;
  letter-spacing: 2rpx;
  color: var(--arc-red);
}

.now-name {
  font-size: 34rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
  color: var(--arc-ink);
}

.next-stop {
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--arc-muted);
}

.route-now__btn {
  flex: none;
  width: auto;
  min-height: 88rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
}

.route-complete {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 22rpx;
  padding: 20rpx;
  background: var(--arc-paper);
  border: 1rpx solid var(--arc-line);
  border-left: 2rpx solid var(--arc-red);
}

.complete-title {
  font-size: 30rpx;
  line-height: 1.4;
  color: var(--arc-ink);
}

.complete-note {
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--arc-muted);
}

/* ---------- 游线站点 ---------- */
.selected-stops {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  margin-top: 24rpx;
  border-top: 1rpx solid var(--arc-line-strong);
}

.selected-stop {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 15rpx 0;
  border-bottom: 1rpx solid var(--arc-line);
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--arc-ink);
}

.stop-number {
  flex: none;
  width: 34rpx;
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: var(--arc-muted);
}

.stop-name {
  flex: 1;
  min-width: 0;
}

.stop-status {
  flex: none;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: var(--arc-muted);
}

.selected-stop.visited {
  color: var(--arc-blue);
}

.selected-stop.visited .stop-status {
  color: var(--arc-blue);
}

.selected-stop.current {
  color: var(--arc-red);
}

.selected-stop.current .stop-number,
.selected-stop.current .stop-status {
  color: var(--arc-red);
}

.selected-notice {
  position: relative;
  z-index: 2;
  display: block;
  margin-top: 16rpx;
  padding-left: 14rpx;
  border-left: 2rpx solid var(--arc-line-strong);
  font-size: 20rpx;
  line-height: 1.7;
  color: var(--arc-muted);
}

/* ---------- 底部动作 ---------- */
.guide-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 40rpx;
}

.guide-actions .arc-btn {
  width: 100%;
}

.guide-foot {
  margin-top: 30rpx;
}

.guide-foot__note {
  display: block;
  margin-top: 14rpx;
  text-align: center;
  font-size: 19rpx;
  line-height: 1.7;
  letter-spacing: 1rpx;
  color: var(--arc-muted);
}

/* ---------- 大字模式 ---------- */
.font-large .guide-head__title {
  font-size: 74rpx;
}

.font-large .guide-head__folio,
.font-large .guide-head__rule-meta {
  font-size: 22rpx;
}

.font-large .text-btn {
  min-height: 72rpx;
  font-size: 26rpx;
}

.font-large .point-sheet__open {
  min-height: 88rpx;
  font-size: 28rpx;
}

.font-large .route-now__btn {
  min-height: 88rpx;
  font-size: 26rpx;
}

.font-large .guide-head__lede {
  font-size: 30rpx;
}

.font-large .guide-notice__text {
  font-size: 27rpx;
}

.font-large .point-sheet__name {
  font-size: 48rpx;
}

.font-large .point-sheet__note,
.font-large .point-list__count,
.font-large .selected-notice,
.font-large .guide-foot__note {
  font-size: 26rpx;
}

.font-large .point-name {
  font-size: 29rpx;
}

.font-large .point-number {
  width: 42rpx;
  height: 42rpx;
  font-size: 20rpx;
}

.font-large .map-status__key {
  font-size: 26rpx;
}

.font-large .now-label {
  font-size: 26rpx;
}

.font-large .stop-number {
  width: 42rpx;
  font-size: 24rpx;
}

.font-large .map-status__row,
.font-large .map-status__source,
.font-large .selected-theme,
.font-large .next-stop,
.font-large .complete-note {
  font-size: 28rpx;
}

.font-large .selected-name {
  font-size: 46rpx;
}

.font-large .now-name,
.font-large .complete-title {
  font-size: 38rpx;
}

.font-large .selected-stop {
  font-size: 30rpx;
}

.font-large .stop-status {
  font-size: 24rpx;
}

.font-large .map-label {
  font-size: 29rpx;
}

.font-large .map-caption {
  font-size: 26rpx;
}

.font-large .route-badge {
  font-size: 23rpx;
}

.font-large .site-dot {
  width: 52rpx;
  height: 52rpx;
  font-size: 23rpx;
}

.font-large .route-poi {
  max-width: 230rpx;
  font-size: 23rpx;
}

.font-large .poi-number {
  width: 34rpx;
  height: 34rpx;
  font-size: 19rpx;
}

/* ---------- 高对比 ---------- */
.guide-page.high-contrast {
  background-color: #fff;
  background-image: none;
}

.high-contrast .guide-head {
  background: #111;
}

.high-contrast .guide-head__lede,
.high-contrast .guide-head__eyebrow,
.high-contrast .guide-head__rule-meta,
.high-contrast .guide-head__folio {
  color: #f2ede4;
}

.high-contrast .guide-offline,
.high-contrast .arc-card,
.high-contrast .map-plate {
  background: #fff;
  border-color: #393939;
}

.high-contrast .guide-notice__text,
.high-contrast .point-sheet__note,
.high-contrast .point-list__count,
.high-contrast .map-status__source,
.high-contrast .progress-label,
.high-contrast .progress-total,
.high-contrast .next-stop,
.high-contrast .complete-note,
.high-contrast .selected-notice,
.high-contrast .stop-status,
.high-contrast .guide-foot__note,
.high-contrast .map-caption {
  color: #222;
}

.high-contrast .map-status__key {
  color: #333;
}

.high-contrast .text-btn {
  border: 0;
  border-bottom: 2rpx solid #111;
