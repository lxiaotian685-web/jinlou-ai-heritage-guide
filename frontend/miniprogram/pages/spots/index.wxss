@import "../../styles/archive.wxss";

/* ==========================================================================
   景点列表 · B 蚝壳青灰
   每条景点按档案条目排版：图版、编号、类别微字、宋体名与细线页脚。
   ========================================================================== */

.spots-page {
  box-sizing: border-box;
  padding: 0 32rpx calc(52rpx + env(safe-area-inset-bottom));
}

/* ---------- 墨色页头 ---------- */
.spots-head {
  position: relative;
  margin: 0 -32rpx;
  padding: 42rpx 36rpx 32rpx;
  background-color: var(--arc-ink);
  background-image: linear-gradient(158deg, rgba(250, 246, 238, 0.08), rgba(250, 246, 238, 0) 62%);
  color: var(--arc-cream);
  overflow: hidden;
}

.spots-head__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.spots-head__eyebrow {
  color: rgba(250, 246, 238, 0.56);
}

.spots-head__folio {
  flex: none;
  font-size: 18rpx;
  line-height: 1.5;
  letter-spacing: 3rpx;
  color: rgba(250, 246, 238, 0.56);
}

.spots-head__main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 18rpx;
}

.spots-head__copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.spots-head__title {
  font-size: 66rpx;
  line-height: 1.2;
  letter-spacing: 6rpx;
  color: var(--arc-cream);
}

.spots-head__lede {
  display: block;
  font-size: 23rpx;
  line-height: 1.8;
  letter-spacing: 1rpx;
  color: rgba(250, 246, 238, 0.64);
}

.spots-head__seal {
  flex: none;
  width: 84rpx;
  height: 84rpx;
  margin-top: 6rpx;
  border-color: rgba(250, 246, 238, 0.56);
  box-shadow: inset 0 0 0 4rpx var(--arc-ink), inset 0 0 0 5rpx rgba(250, 246, 238, 0.5);
  color: rgba(250, 246, 238, 0.86);
  font-size: 20rpx;
}

.spots-head__rule {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 26rpx;
}

.spots-head__rule-line {
  flex: 1;
  height: 1rpx;
  background: rgba(250, 246, 238, 0.2);
}

.spots-head__rule-meta {
  flex: none;
  font-size: 18rpx;
  line-height: 1.5;
  letter-spacing: 3rpx;
  color: rgba(250, 246, 238, 0.56);
}

.spots-body {
  padding-top: 26rpx;
}

/* ---------- 离线提示 ---------- */
.spots-offline {
  margin-bottom: 22rpx;
  padding: 16rpx 20rpx;
  background: var(--arc-cream);
  border: 1rpx solid var(--arc-line);
  border-left: 3rpx solid var(--arc-red);
  border-radius: 4rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--arc-blue);
}

/* ---------- 加载 / 错误 / 空 ---------- */
.spots-state {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 34rpx 30rpx;
}

.spots-state__title {
  font-size: 34rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
  color: var(--arc-ink);
}

.spots-state__line {
  width: 88rpx;
  height: 2rpx;
  background: var(--arc-red);
}

.spots-error {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14rpx;
}

.spots-error__title {
  font-size: 36rpx;
  line-height: 1.4;
  color: var(--arc-ink);
}

.spots-error__body {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--arc-muted);
}

.spots-error__btn {
  width: auto;
  min-width: 260rpx;
  margin-top: 4rpx;
}

.spots-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.spots-empty__body {
  font-size: 24rpx;
  line-height: 1.75;
  color: var(--arc-muted);
}

.empty-title {
  font-size: 32rpx;
  line-height: 1.4;
  color: var(--arc-ink);
}

.spots-empty__btn {
  width: auto;
  min-width: 280rpx;
  margin-top: 6rpx;
}

/* ---------- 参观进度 ---------- */
.progress-card {
  margin-bottom: 22rpx;
  padding: 24rpx;
}

.progress-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
}

.progress-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.progress-title {
  font-size: 32rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
  color: var(--arc-ink);
}

.progress-nums {
  display: flex;
  flex: none;
  align-items: baseline;
  gap: 6rpx;
}

.progress-count {
  font-size: 48rpx;
  line-height: 1;
  color: var(--arc-ink);
}

.progress-total {
  font-size: 24rpx;
  line-height: 1.2;
  color: var(--arc-muted);
}

.progress-track {
  position: relative;
  height: 3rpx;
  margin-top: 16rpx;
  background: var(--arc-line);
}

.progress-value {
  position: relative;
  height: 3rpx;
  background: var(--arc-red);
  transition: width 200ms ease;
}

.progress-value::after {
  content: "";
  position: absolute;
  top: -3rpx;
  right: -3rpx;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: var(--arc-red);
}

/* ---------- 检索与筛选 ---------- */
.tools {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 22rpx;
  padding: 24rpx;
}

.tools__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.tools__meta {
  flex: none;
  font-size: 18rpx;
  line-height: 1.5;
  letter-spacing: 2rpx;
  color: var(--arc-muted);
}

.tools__rule {
  height: 1rpx;
  background: var(--arc-line);
}

.search-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: var(--arc-oyster);
  border: 1rpx solid var(--arc-line-strong);
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 80rpx;
  color: var(--arc-ink);
}

.search-placeholder {
  color: var(--arc-muted);
}

.reset-button {
  flex: none;
  display: inline-flex;
  align-items: flex-end;
  width: auto;
  min-height: 64rpx;
  margin: 0;
  padding: 0 4rpx 8rpx;
  background: transparent;
  border: 0;
  border-bottom: 1rpx solid rgba(166, 64, 45, 0.5);
  border-radius: 0;
  font-size: 22rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
  color: var(--arc-red);
}

.personal-filter-row {
  display: flex;
  gap: 10rpx;
}

.filter-btn {
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  margin: 0;
  padding: 8rpx 10rpx;
  background: transparent;
  border: 1rpx solid var(--arc-line-strong);
  border-radius: 6rpx;
  font-size: 21rpx;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
  color: var(--arc-blue);
}

.filter-btn.active {
  background: var(--arc-ink);
  border-color: var(--arc-ink);
  color: var(--arc-cream);
}

.storage-note {
  font-size: 19rpx;
  line-height: 1.6;
  letter-spacing: 0.5rpx;
  color: var(--arc-muted);
}

.sort-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.sort-row__label {
  margin-right: 4rpx;
  font-size: 20rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
  color: var(--arc-muted);
}

.sort-row button {
  flex: none;
  width: auto;
  min-height: 64rpx;
  margin: 0;
  padding: 8rpx 14rpx;
  background: transparent;
  border: 1rpx solid var(--arc-line);
  border-radius: 4rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--arc-blue);
}

.sort-row button.active {
  background: var(--arc-ink);
  border-color: var(--arc-ink);
  color: var(--arc-cream);
}

.category-scroll {
  width: 100%;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 10rpx;
  padding-right: 20rpx;
}

.category-button {
  flex: none;
  width: auto;
  min-height: 64rpx;
  margin: 0;
  padding: 8rpx 18rpx;
  background: transparent;
  border: 1rpx solid var(--arc-line-strong);
  border-radius: 4rpx;
  font-size: 21rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
  color: var(--arc-blue);
}

.category-button.active {
  background: var(--arc-ink);
  border-color: var(--arc-ink);
  color: var(--arc-cream);
}

.result-count {
  font-size: 19rpx;
  line-height: 1.6;
  letter-spacing: 1rpx;
  color: var(--arc-muted);
}

/* ---------- 景点档案条目 ---------- */
.list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 26rpx;
}

.spot {
  position: relative;
  padding: 14rpx;
  transition: background-color 160ms ease;
}

.spot--press {
  background: var(--arc-paper);
}

/* 让裁切角标压在照片之上，像档案卡的定位角 */
.spot.arc-card--ticks::before,
.spot.arc-card--ticks::after {
  z-index: 5;
}

.spot__media {
  position: relative;
  height: 300rpx;
  overflow: hidden;
  border-radius: 2rpx;
}

.spot__cover {
  display: block;
  width: 100%;
  height: 100%;
}

.spot__shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  background: linear-gradient(180deg, rgba(20, 28, 24, 0.08) 0%, rgba(20, 28, 24, 0) 42%, rgba(20, 28, 24, 0.14) 100%);
  pointer-events: none;
}

.spot__folio {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  z-index: 3;
  display: flex;
  align-items: baseline;
  gap: 5rpx;
  padding: 5rpx 10rpx 4rpx;
  background: rgba(250, 246, 238, 0.94);
  border: 1rpx solid rgba(36, 48, 41, 0.2);
  border-radius: 2rpx;
}

.spot__folio-label {
  font-size: 18rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
  color: var(--arc-muted);
}

.spot__folio-num {
  font-size: 24rpx;
  line-height: 1;
  color: var(--arc-ink);
}

.spot__body {
  position: relative;
  z-index: 2;
  padding: 12rpx 8rpx 4rpx;
}

.spot__meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 14rpx;
}

.spot__category {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  line-height: 1.5;
  letter-spacing: 3rpx;
  color: var(--arc-blue);
}

.spot__file {
  flex: none;
  font-size: 18rpx;
  line-height: 1.5;
  letter-spacing: 2rpx;
  color: var(--arc-muted);
}

.name-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 8rpx;
}

.spot__name {
  font-size: 42rpx;
  line-height: 1.34;
  letter-spacing: 1rpx;
  color: var(--arc-ink);
}

.spot__pron {
  font-size: 20rpx;
  line-height: 1.5;
  letter-spacing: 0.5rpx;
  color: var(--arc-muted);
}

.spot__summary {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.78;
  color: var(--arc-blue);
}

.spot__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}

.spot__tag {
  flex: none;
}

.spot__hair {
  margin-top: 18rpx;
}

.spot__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10rpx 16rpx;
  padding: 12rpx 0 2rpx;
}

.spot__source {
  flex: 1;
  min-width: 260rpx;
  font-size: 18rpx;
  line-height: 1.6;
  letter-spacing: 0.5rpx;
  color: var(--arc-muted);
}

.spot__enter {
  flex: none;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
  color: var(--arc-ink);
}

.spot__arrow {
  font-size: 20rpx;
  line-height: 1;
  color: var(--arc-red);
}

/* ---------- 页脚 ---------- */
.spots-foot {
  margin-top: 36rpx;
}

.spots-foot__note {
  display: block;
  margin-top: 14rpx;
  text-align: center;
  font-size: 19rpx;
  line-height: 1.7;
  letter-spacing: 1rpx;
  color: var(--arc-muted);
}

/* ---------- 大字模式 ---------- */
.font-large .spots-head__title {
  font-size: 74rpx;
}

.font-large .spots-head__lede {
  font-size: 30rpx;
}

.font-large .spots-head__folio,
.font-large .spots-head__rule-meta,
.font-large .tools__meta {
  font-size: 22rpx;
}

.font-large .spots-state__title,
.font-large .spots-error__title {
  font-size: 40rpx;
}

.font-large .spots-error__body,
.font-large .spots-empty__body {
  font-size: 30rpx;
}

.font-large .progress-title {
  font-size: 38rpx;
}

.font-large .progress-count {
  font-size: 54rpx;
}

.font-large .progress-total {
  font-size: 28rpx;
}

.font-large .search-input {
  height: 96rpx;
  font-size: 30rpx;
  line-height: 96rpx;
}

.font-large .filter-btn {
  min-height: 80rpx;
  font-size: 26rpx;
}

.font-large .sort-row button,
.font-large .category-button {
  min-height: 64rpx;
  font-size: 26rpx;
}

.font-large .sort-row__label {
  font-size: 26rpx;
}

.font-large .spot__folio-num {
  font-size: 28rpx;
}

.font-large .spot__folio-label {
  font-size: 22rpx;
}

.font-large .spot__arrow {
  font-size: 26rpx;
}

.font-large .storage-note,
.font-large .result-count {
  font-size: 25rpx;
}

.font-large .spot__category {
  font-size: 26rpx;
}

.font-large .spot__file,
.font-large .spot__pron {
  font-size: 22rpx;
}

.font-large .spot__name {
  font-size: 50rpx;
}

.font-large .spot__summary {
  font-size: 31rpx;
}

.font-large .spot__tag {
  font-size: 23rpx;
}

.font-large .spot__source {
  font-size: 24rpx;
}

.font-large .spot__enter {
  font-size: 26rpx;
}

.font-large .spots-foot__note {
  font-size: 25rpx;
}

/* ---------- 高对比 ---------- */
.spots-page.high-contrast {
  background-color: #fff;
  background-image: none;
}

.high-contrast .spots-head {
  background: #111;
}

.high-contrast .spots-head__lede,
.high-contrast .spots-head__eyebrow,
.high-contrast .spots-head__rule-meta,
.high-contrast .spots-head__folio {
  color: #f2ede4;
}

.high-contrast .spots-offline,
.high-contrast .arc-card,
.high-contrast .arc-empty {
  background: #fff;
  border-color: #393939;
}

.high-contrast .storage-note,
.high-contrast .result-count,
.high-contrast .spot__source,
.high-contrast .spot__file,
.high-contrast .spot__pron,
.high-contrast .spots-foot__note,
.high-contrast .spots-error__body,
.high-contrast .spots-empty__body {
  color: #222;
}

.high-contrast .spot__summary,
.high-contrast .spot__category {
  color: #243029;
}

.high-contrast .search-input {
  background: #fff;
  border-color: #393939;
}

.high-contrast .reset-button {
  border: 0;
  border-bottom: 2rpx solid #111;
  color: #111;
}

@media (prefers-reduced-motion: reduce) {
  .progress-value,
  .spot {
    transition: none;
  }
}
