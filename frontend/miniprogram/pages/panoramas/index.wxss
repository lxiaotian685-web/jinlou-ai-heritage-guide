.heading { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 28rpx; }.heading .muted { font-size: 24rpx; }
.list { display: flex; flex-direction: column; gap: 24rpx; }.preview { width: 100%; height: 350rpx; }
.content { padding: 28rpx; display: flex; flex-direction: column; gap: 18rpx; }.row { display: flex; justify-content: space-between; align-items: center; }
.name { font-size: 36rpx; font-weight: 600; }.badge { color: #7b581b; border: 1rpx solid #b58b4a; border-radius: 8rpx; padding: 6rpx 12rpx; font-size: 22rpx; }
.summary { color: #4e4540; font-size: 27rpx; line-height: 1.6; }.state { padding: 30rpx; display: flex; flex-direction: column; gap: 20rpx; }
