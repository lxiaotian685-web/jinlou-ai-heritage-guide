@import "../../styles/archive.wxss";

/* ==========================================================================
   AR 木雕寻宝 · B 蚝壳青灰 / 档案式取景
   墨色取景区 + 米白档案面板；仅取景框四角使用金赭色作为唯一强调。
   ========================================================================== */

page {
  background-color: #f2ede4;
}

.panoramas-page {
  box-sizing: border-box;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* 相机 / 探索阶段由底部弹层自带安全区内边距，页面不再重复留白 */
.panoramas-page.is-stage {
  padding-bottom: 0;
}

/* 进入取景后页头收紧，把纵向空间让给画面 */
.is-stage .ar-mast {
  gap: 8rpx;
  padding-top: 24rpx;
}

.is-stage .ar-mast__title {
  font-size: 40rpx;
  line-height: 1.3;
}

.is-stage .ar-mast__lede {
  display: none;
}

/* 页面内所有按钮统一触控基线 */
.panoramas-page button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
}

/* ---------- 页头 ---------- */
.ar-mast {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 40rpx 32rpx 0;
}

.ar-mast__meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.ar-mast__eyebrow {
  flex: 1;
  min-width: 0;
}

.ar-mast__place {
  flex: none;
  font-size: 18rpx;
  line-height: 1.6;
  letter-spacing: 3rpx;
  color: var(--arc-red);
}

.ar-mast__title {
  font-size: 56rpx;
  line-height: 1.24;
}

.ar-mast__lede {
  max-width: 640rpx;
}

/* ---------- 流程索引 ---------- */
.ar-steps {
  display: flex;
  align-items: center;
  margin: 26rpx 32rpx 0;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--arc-line-strong);
  border-bottom: 1rpx solid var(--arc-line);
}

.ar-step {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.ar-step + .ar-step {
  padding-left: 18rpx;
  border-left: 1rpx solid var(--arc-line);
}

.ar-step__dot {
  flex: none;
  box-sizing: border-box;
  width: 10rpx;
  height: 10rpx;
  border: 1rpx solid var(--arc-line-strong);
  border-radius: 50%;
  background-color: transparent;
}

.ar-step__label {
  min-width: 0;
  font-size: 20rpx;
  line-height: 1.5;
  letter-spacing: 2rpx;
  color: var(--arc-muted);
}

.ar-step.is-on .ar-step__dot {
  border-color: var(--arc-ink);
  background-color: var(--arc-ink);
}

.ar-step.is-on .ar-step__label {
  color: var(--arc-ink);
}

.ar-step.is-current .ar-step__dot {
  border-color: var(--arc-red);
  background-color: var(--arc-red);
  box-shadow: 0 0 0 5rpx rgba(166, 64, 45, 0.14);
}

.ar-step.is-current .ar-step__label {
  color: var(--arc-red);
}

/* ---------- 开始页 ---------- */
.ar-intro {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  padding: 34rpx 32rpx 0;
}

.ar-specimen {
  display: flex;
  flex-direction: column;
}

.ar-specimen__photo {
  position: relative;
  height: 360rpx;
  border-radius: 6rpx;
}

.ar-specimen__photo::after {
  border-radius: 6rpx;
}

.ar-specimen__photo image {
  display: block;
  width: 100%;
  height: 100%;
}

.ar-specimen__tag {
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  z-index: 2;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  background-color: rgba(20, 27, 23, 0.7);
  color: #f2ede4;
  font-size: 17rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.ar-specimen__caption {
  padding: 0 2rpx;
}

.ar-kicker {
  display: block;
  font-size: 19rpx;
  line-height: 1.6;
  letter-spacing: 4rpx;
  color: var(--arc-muted);
}

.ar-kicker--red {
  color: var(--arc-red);
}

.ar-h2 {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  line-height: 1.38;
  letter-spacing: 1rpx;
  color: var(--arc-ink);
  word-break: break-word;
  overflow-wrap: anywhere;
}

.ar-body {
  display: block;
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.78;
  color: var(--arc-muted);
  word-break: break-word;
  overflow-wrap: anywhere;
}

.ar-body--sm {
  font-size: 24rpx;
  line-height: 1.7;
}

/* 体验前准备：编号清单 */
.ar-prep {
  display: flex;
  flex-direction: column;
  border-top: 1rpx solid var(--arc-line);
}

.ar-prep__item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--arc-line);
}

.ar-prep__num {
  flex: none;
  width: 48rpx;
  font-size: 19rpx;
  line-height: 1.9;
  letter-spacing: 1rpx;
  color: var(--arc-red);
}

.ar-prep__text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.75;
  color: var(--arc-ink);
  word-break: break-word;
  overflow-wrap: anywhere;
}

/* 主行动 */
.ar-cta {
  width: 100%;
  min-height: 92rpx;
  letter-spacing: 3rpx;
}

/* 历史完成章 */
.ar-stamp {
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border: 1rpx dashed rgba(166, 64, 45, 0.42);
  border-radius: 8rpx;
  background-color: rgba(250, 246, 238, 0.6);
  animation: ar-reveal 0.4s ease-out both;
}

.ar-stamp__seal {
  flex: none;
  flex-direction: column;
  width: 88rpx;
  height: 88rpx;
  background-color: var(--arc-cream);
  font-size: 17rpx;
  letter-spacing: 0;
}

.ar-stamp__copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ar-stamp__title {
  font-size: 27rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
  color: var(--arc-red);
  word-break: break-word;
  overflow-wrap: anywhere;
}

.ar-stamp__note {
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--arc-muted);
  word-break: break-word;
  overflow-wrap: anywhere;
}

/* ---------- 取景区 ---------- */
.ar-stage {
  position: relative;
  width: 100%;
  height: 660rpx;
  margin-top: 28rpx;
  overflow: hidden;
  background-color: #141b17;
}

.ar-stage__media {
  display: block;
  width: 100%;
  height: 100%;
}

.ar-stage__shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  background-image: linear-gradient(
    180deg,
    rgba(10, 14, 12, 0.62) 0%,
    rgba(10, 14, 12, 0.16) 22%,
    rgba(10, 14, 12, 0.08) 58%,
    rgba(10, 14, 12, 0.72) 100%
  );
  pointer-events: none;
}

.ar-stage.is-discovery .ar-stage__shade {
  background-image: linear-gradient(
    180deg,
    rgba(10, 14, 12, 0.6) 0%,
    rgba(10, 14, 12, 0.05) 30%,
    rgba(10, 14, 12, 0.22) 78%,
    rgba(10, 14, 12, 0.62) 100%
  );
}

.ar-stage__top {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  left: 24rpx;
  z-index: 4;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  pointer-events: none;
}

/* 相机状态 */
.ar-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(250, 246, 238, 0.22);
  border-radius: 999rpx;
  background-color: rgba(20, 27, 23, 0.74);
}

.ar-status__dot {
  flex: none;
  box-sizing: border-box;
  width: 12rpx;
  height: 12rpx;
  border: 1rpx solid #f2ede4;
  border-radius: 50%;
  background-color: #f2ede4;
  animation: ar-pulse 1.6s ease-in-out infinite;
}

.ar-status__dot.is-ready {
  animation: none;
  box-shadow: 0 0 0 4rpx rgba(250, 246, 238, 0.16);
}

.ar-status__dot.is-fallback {
  animation: none;
  background-color: transparent;
}

.ar-status__text {
  font-size: 20rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
  white-space: nowrap;
  color: #f5f1e8;
}

.ar-chip {
  flex: none;
  box-sizing: border-box;
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(250, 246, 238, 0.34);
  border-radius: 6rpx;
  background-color: rgba(20, 27, 23, 0.76);
  color: #f5f1e8;
  font-size: 20rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

/* 取景框：四角金赭 + 扫描线 */
.ar-frame {
  position: absolute;
  top: 19%;
  left: 13%;
  z-index: 2;
  box-sizing: border-box;
  width: 74%;
  height: 54%;
  border: 1rpx solid rgba(201, 162, 39, 0.2);
  border-radius: 6rpx;
}

.ar-frame__corner {
  position: absolute;
  box-sizing: border-box;
  width: 44rpx;
  height: 44rpx;
  border: 0 solid #c9a227;
  animation: ar-corner 3.2s ease-in-out infinite;
}

.ar-frame__corner--tr {
  animation-delay: 0.18s;
}

.ar-frame__corner--bl {
  animation-delay: 0.36s;
}

.ar-frame__corner--br {
  animation-delay: 0.54s;
}

.ar-frame__corner--tl {
  top: 0;
  left: 0;
  border-top-width: 3rpx;
  border-left-width: 3rpx;
}

.ar-frame__corner--tr {
  top: 0;
  right: 0;
  border-top-width: 3rpx;
  border-right-width: 3rpx;
}

.ar-frame__corner--bl {
  bottom: 0;
  left: 0;
  border-bottom-width: 3rpx;
  border-left-width: 3rpx;
}

.ar-frame__corner--br {
  right: 0;
  bottom: 0;
  border-right-width: 3rpx;
  border-bottom-width: 3rpx;
}

.ar-frame__scan {
  position: absolute;
  top: 0;
  right: -1rpx;
  left: -1rpx;
  height: 3rpx;
  background-image: linear-gradient(
    90deg,
    rgba(201, 162, 39, 0) 0%,
    rgba(201, 162, 39, 0.8) 50%,
    rgba(201, 162, 39, 0) 100%
  );
  box-shadow: 0 0 18rpx rgba(201, 162, 39, 0.4);
  animation: ar-scan 4.6s ease-in-out infinite;
}

.ar-scan-copy {
  position: absolute;
  right: 32rpx;
  bottom: 36rpx;
  left: 32rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  text-align: center;
}

.ar-scan-copy__title {
  font-size: 28rpx;
  line-height: 1.4;
  letter-spacing: 3rpx;
  color: #f7f3ea;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.72);
}

.ar-scan-copy__hint {
  font-size: 20rpx;
  line-height: 1.5;
  letter-spacing: 2rpx;
  color: rgba(247, 243, 234, 0.74);
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.68);
}

/* 热点按钮：≥76rpx，编号 / ✓ 两态 */
.ar-hotspot {
  position: absolute;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 76rpx;
  height: 76rpx;
  min-width: 76rpx;
  min-height: 76rpx;
  margin: -38rpx 0 0 -38rpx;
  padding: 0;
  border: 2rpx solid rgba(250, 246, 238, 0.86);
  border-radius: 50%;
  background-color: rgba(20, 27, 23, 0.76);
  color: #f7f3ea;
  font-size: 26rpx;
  line-height: 1;
  letter-spacing: 0;
  text-align: center;
  box-shadow: 0 8rpx 22rpx rgba(8, 12, 10, 0.4);
  transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
}

.ar-hotspot.is-visited {
  border-color: #f2ede4;
  background-color: rgba(242, 237, 228, 0.94);
  color: #243029;
}

.ar-hotspot.is-active {
  border-color: #faf6ee;
  background-color: var(--arc-red);
  color: #faf6ee;
  transform: scale(1.06);
  box-shadow: 0 0 0 8rpx rgba(166, 64, 45, 0.22), 0 8rpx 22rpx rgba(8, 12, 10, 0.4);
}

/* ---------- 底部弹层 ---------- */
.ar-panel {
  position: relative;
  z-index: 5;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-sizing: border-box;
  margin-top: -26rpx;
  padding: 14rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background-color: var(--arc-cream);
  border-top: 1rpx solid var(--arc-line-strong);
  border-radius: 20rpx 20rpx 0 0;
  box-shadow: 0 -14rpx 36rpx rgba(20, 27, 23, 0.14);
}

.ar-sheet__handle {
  width: 64rpx;
  height: 6rpx;
  margin: 2rpx auto 10rpx;
  border-radius: 999rpx;
  background-color: var(--arc-line-strong);
}

.ar-panel__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.ar-panel__step {
  flex: none;
  font-size: 16rpx;
  line-height: 1.6;
  letter-spacing: 2rpx;
  color: var(--arc-muted);
}

/* 按钮：统一触控与对齐基线 */
.ar-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 4rpx;
}

.ar-btn--block {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  text-align: center;
}

/* 三级文字动作，仍保留 88rpx 触控高度 */
.ar-quiet {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background-color: transparent;
  color: var(--arc-muted);
  font-size: 23rpx;
  line-height: 1.5;
  letter-spacing: 2rpx;
  text-align: center;
}

.ar-quiet__label {
  border-bottom: 1rpx solid var(--arc-line-strong);
  line-height: 1.9;
}

/* 相机错误卡 */
.ar-error {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  box-sizing: border-box;
  padding: 24rpx 24rpx 20rpx;
  border: 1rpx solid rgba(166, 64, 45, 0.24);
  border-left: 3rpx solid var(--arc-red);
  border-radius: 8rpx;
  background-color: rgba(166, 64, 45, 0.05);
}

.ar-error__msg {
  color: #6b3a2f;
  font-size: 24rpx;
  line-height: 1.7;
}

.ar-error .ar-body {
  margin-top: 0;
}

/* ---------- 探索面板 ---------- */
.ar-discovery {
  gap: 14rpx;
}

.ar-quest {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.ar-quest__copy {
  flex: 1;
  min-width: 0;
}

.ar-quest__count {
  flex: none;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.ar-quest__num {
  font-family: "Songti SC", "Noto Serif SC", SimSun, serif;
  font-size: 48rpx;
  line-height: 1;
  color: var(--arc-ink);
}

.ar-quest__total {
  font-size: 20rpx;
  line-height: 1.5;
  letter-spacing: 2rpx;
  color: var(--arc-muted);
}

/* 三段进度：填充过渡 */
.ar-track {
  display: flex;
  gap: 8rpx;
  margin-top: 2rpx;
}

.ar-track__seg {
  position: relative;
  flex: 1;
  height: 6rpx;
  overflow: hidden;
  border-radius: 6rpx;
  background-color: var(--arc-line);
}

.ar-track__seg::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: var(--arc-ink);
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform 0.4s ease;
}

.ar-track__seg.is-on::after {
  transform: scaleX(1);
}

/* 热点标签页：横向滚动，72rpx 触控 */
.ar-tabs {
  width: 100%;
  margin-top: 2rpx;
  white-space: nowrap;
}

.ar-tabs__track {
  display: inline-flex;
  gap: 10rpx;
  padding: 2rpx 0;
  vertical-align: top;
}

.ar-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex: none;
  min-height: 72rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid var(--arc-line);
  border-radius: 6rpx;
  background-color: transparent;
  color: var(--arc-muted);
  font-size: 22rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
  text-align: center;
  white-space: nowrap;
}

.ar-tab.is-visited {
  border-color: var(--arc-line-strong);
  color: var(--arc-ink);
}

.ar-tab.is-active {
  border-color: var(--arc-ink);
  background-color: var(--arc-ink);
  color: var(--arc-cream);
}

/* 详情卡 */
.ar-detail {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  margin-top: 4rpx;
  padding: 26rpx 24rpx;
  border-radius: 12rpx;
  background-color: #f6f1e6;
}

.ar-detail__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.ar-detail__no {
  flex: none;
  font-size: 16rpx;
  line-height: 1.6;
  letter-spacing: 2rpx;
  color: var(--arc-muted);
}

.ar-detail__title {
  display: block;
  margin-top: 6rpx;
  font-size: 34rpx;
  line-height: 1.42;
  letter-spacing: 1rpx;
  color: var(--arc-ink);
  word-break: break-word;
  overflow-wrap: anywhere;
}

.ar-detail__desc {
  margin-top: 8rpx;
  color: #4c564f;
}

.ar-detail__rule {
  margin: 18rpx 0 14rpx;
}

.ar-safety {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.ar-safety__mark {
  flex: none;
  width: 2rpx;
  height: 22rpx;
  margin-top: 10rpx;
  background-color: var(--arc-red);
}

.ar-safety__text {
  flex: 1;
  min-width: 0;
  font-size: 21rpx;
  line-height: 1.7;
  color: var(--arc-muted);
  word-break: break-word;
  overflow-wrap: anywhere;
}

/* 讲解 / 问答 */
.ar-pair {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 4rpx;
}

.ar-pair__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 0 12rpx;
  font-size: 24rpx;
  line-height: 1.35;
  letter-spacing: 1rpx;
  text-align: center;
}

/* 未解锁：虚线卡 */
.ar-lock {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  box-sizing: border-box;
  margin-top: 6rpx;
  padding: 26rpx 24rpx;
  border: 1rpx dashed var(--arc-line-strong);
  border-radius: 12rpx;
  background-color: rgba(250, 246, 238, 0.6);
}

.ar-lock__mark {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid var(--arc-line-strong);
  border-radius: 6rpx;
  color: var(--arc-muted);
  font-family: "Songti SC", "Noto Serif SC", SimSun, serif;
  font-size: 32rpx;
  line-height: 1;
}

.ar-lock__copy {
  flex: 1;
  min-width: 0;
}

.ar-lock__title {
  display: block;
  margin-top: 4rpx;
  font-size: 30rpx;
  line-height: 1.42;
  letter-spacing: 1rpx;
  color: var(--arc-ink);
  word-break: break-word;
  overflow-wrap: anywhere;
}

/* 问答卡 */
.ar-quiz {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  box-sizing: border-box;
  margin-top: 6rpx;
  padding: 26rpx 24rpx;
  border: 1rpx solid var(--arc-line-strong);
  border-radius: 12rpx;
  background-color: #f7f2e8;
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.ar-quiz.is-passed {
  border-color: rgba(166, 64, 45, 0.38);
  background-color: #fbf7ee;
  box-shadow: inset 4rpx 0 0 var(--arc-red);
}

.ar-quiz__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.ar-quiz__state {
  flex: none;
  font-size: 16rpx;
  line-height: 1.6;
  letter-spacing: 2rpx;
  color: var(--arc-muted);
}

.ar-quiz__title {
  display: block;
  font-size: 32rpx;
  line-height: 1.42;
  letter-spacing: 1rpx;
  color: var(--arc-ink);
  word-break: break-word;
  overflow-wrap: anywhere;
}

.ar-quiz__question {
  margin-top: 0;
}

.ar-options {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 4rpx;
}

.ar-option {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--arc-line);
  border-radius: 8rpx;
  background-color: var(--arc-cream);
  color: var(--arc-ink);
  font-size: 24rpx;
  line-height: 1.6;
  letter-spacing: 1rpx;
  text-align: center;
}

/* 提高一级优先级，覆盖小程序 button 的默认禁用样式 */
.panoramas-page .ar-option[disabled] {
  border-color: var(--arc-line);
  background-color: var(--arc-cream);
  color: var(--arc-muted);
  opacity: 1;
}

.panoramas-page .ar-option.is-correct {
  border-color: #7c9080;
  background-color: #e4ebdf;
  color: #243029;
}

.panoramas-page .ar-option.is-wrong {
  border-color: rgba(166, 64, 45, 0.5);
  background-color: #f3e2dc;
  color: #7b3a2f;
}

.ar-option__letter {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 40rpx;
  height: 40rpx;
  margin-right: 14rpx;
  border: 1rpx solid currentColor;
  border-radius: 50%;
  font-size: 19rpx;
  line-height: 1;
}

.ar-option.is-correct .ar-option__letter {
  border-color: #243029;
  background-color: #243029;
  color: #faf6ee;
}

.ar-option.is-wrong .ar-option__letter {
  border-color: var(--arc-red);
  background-color: var(--arc-red);
  color: #faf6ee;
}

.ar-option__text {
  flex: 1;
  min-width: 0;
  text-align: left;
  word-break: break-word;
  overflow-wrap: anywhere;
}

/* 反馈 */
.ar-feedback {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  line-height: 1.75;
  color: var(--arc-red);
  word-break: break-word;
  overflow-wrap: anywhere;
}

.ar-feedback.is-success {
  color: #3f5b49;
}

/* 通关奖励：明显但不喧哗 */
.ar-reward {
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-sizing: border-box;
  margin-top: 10rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(166, 64, 45, 0.28);
  border-radius: 10rpx;
  background-color: rgba(166, 64, 45, 0.05);
  animation: ar-reveal 0.45s ease-out both;
}

.ar-reward__seal {
  flex: none;
  flex-direction: column;
  width: 84rpx;
  height: 84rpx;
  background-color: var(--arc-cream);
  font-size: 20rpx;
  letter-spacing: 0;
}

.ar-reward__copy {
  flex: 1;
  min-width: 0;
}

.ar-reward__title {
  display: block;
  margin-top: 4rpx;
  font-size: 30rpx;
  line-height: 1.42;
  letter-spacing: 1rpx;
  color: var(--arc-red);
  word-break: break-word;
  overflow-wrap: anywhere;
}

/* ---------- 动效 ---------- */
@keyframes ar-pulse {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.42;
    transform: scale(0.72);
  }
}

@keyframes ar-corner {
  0%,
  100% {
    opacity: 0.55;
  }
  50% {
    opacity: 1;
  }
}

@keyframes ar-scan {
  0% {
    top: 2%;
    opacity: 0;
  }
  14% {
    opacity: 0.88;
  }
  86% {
    opacity: 0.88;
  }
  100% {
    top: 96%;
    opacity: 0;
  }
}

@keyframes ar-reveal {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ---------- L03 小屏：320–360px ---------- */
@media (max-width: 360px) {
  .ar-mast {
    padding: 32rpx 24rpx 0;
  }

  .ar-mast__title {
    font-size: 46rpx;
  }

  .ar-mast__place {
    font-size: 17rpx;
    letter-spacing: 2rpx;
  }

  .ar-steps {
    margin: 22rpx 24rpx 0;
    padding: 14rpx 0;
  }

  .ar-step + .ar-step {
    padding-left: 14rpx;
  }

  .ar-step__label {
    font-size: 19rpx;
    letter-spacing: 1rpx;
  }

  .ar-intro {
    gap: 22rpx;
    padding: 28rpx 24rpx 0;
  }

  .ar-specimen__photo {
    height: 300rpx;
  }

  .ar-stage {
    height: 520rpx;
    margin-top: 22rpx;
  }

  .ar-stage__top {
    top: 18rpx;
    right: 18rpx;
    left: 18rpx;
  }

  .ar-status {
    padding: 8rpx 12rpx;
  }

  .ar-status__text,
  .ar-chip {
    font-size: 20rpx;
    letter-spacing: 1rpx;
  }

  .ar-chip {
    padding: 8rpx 12rpx;
  }

  .ar-frame {
    top: 17%;
    left: 10%;
    width: 80%;
    height: 56%;
  }

  .ar-frame__corner {
    width: 36rpx;
    height: 36rpx;
  }

  .ar-scan-copy {
    bottom: 34rpx;
  }

  .ar-scan-copy__title {
    font-size: 26rpx;
  }

  .ar-hotspot {
    width: 80rpx;
    height: 80rpx;
    min-width: 80rpx;
    min-height: 80rpx;
    margin: -40rpx 0 0 -40rpx;
    font-size: 28rpx;
  }

  .ar-panel {
    padding: 12rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  }

  .ar-h2 {
    font-size: 34rpx;
  }

  .ar-body {
    font-size: 26rpx;
  }

  .ar-tab {
    min-height: 72rpx;
    padding: 0 16rpx;
    font-size: 22rpx;
  }

  .ar-pair {
    grid-template-columns: 1fr;
  }

  .ar-pair__btn {
    font-size: 23rpx;
  }

  .ar-option {
    padding: 14rpx 16rpx;
    font-size: 24rpx;
  }

  .ar-quest__num {
    font-size: 42rpx;
  }

  .ar-detail {
    padding: 22rpx 20rpx;
  }

  .ar-stamp {
    gap: 18rpx;
    padding: 20rpx;
  }
}

