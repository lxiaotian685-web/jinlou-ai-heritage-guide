.ar-page { background:#f3efe5; }
.heading { display:flex; flex-direction:column; gap:12rpx; padding-bottom:8rpx; }
.eyebrow { color:#8a6a2b; font-size:23rpx; letter-spacing:2rpx; }
.heading .muted { font-size:25rpx; line-height:1.65; }
.progress-row { display:grid; grid-template-columns:repeat(3, 1fr); gap:10rpx; padding-top:24rpx; }
.progress-step { padding:14rpx 8rpx; border-radius:999rpx; background:#e6e0d5; color:#77716b; font-size:21rpx; text-align:center; }
.progress-step.active { background:#3a5a47; color:#fff; }
.intro-section { display:flex; flex-direction:column; gap:22rpx; }
.target-card image { width:100%; height:380rpx; }
.target-copy { padding:26rpx; display:flex; flex-direction:column; gap:10rpx; }
.target-label { color:#8a6a2b; font-size:22rpx; }
.target-title { font-size:36rpx; font-weight:600; }
.target-description { color:#5d554f; font-size:25rpx; line-height:1.65; }
.guide-card { padding:26rpx; display:flex; flex-direction:column; gap:14rpx; color:#5d554f; font-size:25rpx; line-height:1.55; }
.guide-title { color:#382c24; font-size:29rpx; font-weight:600; }
.start-button { width:100%; margin:0; }
.completed-note { color:#3a5a47; font-size:23rpx; text-align:center; }
.ar-stage { position:relative; width:100%; height:720rpx; margin-top:22rpx; overflow:hidden; background:#171512; }
.camera,.fallback-image { width:100%; height:100%; }
.stage-shade { position:absolute; inset:0; background:linear-gradient(180deg, rgba(0,0,0,.32), transparent 25%, transparent 70%, rgba(0,0,0,.4)); pointer-events:none; }
.stage-badge { position:absolute; left:28rpx; top:26rpx; padding:10rpx 18rpx; border-radius:999rpx; background:rgba(20,22,19,.72); color:#fff; font-size:22rpx; }
.scan-copy { position:absolute; left:0; right:0; bottom:42rpx; z-index:2; display:flex; flex-direction:column; align-items:center; gap:6rpx; color:#fff; text-shadow:0 2rpx 12rpx rgba(0,0,0,.8); }
.scan-copy text:first-child { font-size:29rpx; font-weight:600; letter-spacing:2rpx; }
.scan-copy text:last-child { font-size:21rpx; opacity:.78; }
.target-frame { position:absolute; left:14%; top:20%; width:72%; height:52%; }
.corner { position:absolute; width:58rpx; height:58rpx; border-color:#f2d58c; }
.corner-a { left:0; top:0; border-left:5rpx solid #f2d58c; border-top:5rpx solid #f2d58c; }
.corner-b { right:0; top:0; border-right:5rpx solid #f2d58c; border-top:5rpx solid #f2d58c; }
.corner-c { left:0; bottom:0; border-left:5rpx solid #f2d58c; border-bottom:5rpx solid #f2d58c; }
.corner-d { right:0; bottom:0; border-right:5rpx solid #f2d58c; border-bottom:5rpx solid #f2d58c; }
.hotspot { position:absolute; z-index:3; width:72rpx; height:72rpx; min-height:72rpx; margin:-36rpx 0 0 -36rpx; padding:0; border:4rpx solid rgba(255,255,255,.86); border-radius:50%; background:rgba(58,90,71,.88); color:#fff; line-height:64rpx; font-size:27rpx; box-shadow:0 8rpx 24rpx rgba(0,0,0,.3); }
.hotspot::after { border:0; }
.hotspot.active { background:#b7792c; transform:scale(1.1); }
.hotspot.visited { border-color:#f2d58c; }
.clue-counter { position:absolute; right:24rpx; top:24rpx; z-index:3; padding:11rpx 18rpx; border-radius:999rpx; background:rgba(20,22,19,.76); color:#f5d98c; font-size:22rpx; letter-spacing:1rpx; }
.align-panel,.discovery-panel { display:flex; flex-direction:column; gap:20rpx; }
.panel-title { font-size:34rpx; font-weight:600; }
.align-panel .muted { font-size:25rpx; line-height:1.65; }
.secondary-button { width:100%; margin:0; background:#e8e0d3; color:#382c24; border-radius:16rpx; font-size:27rpx; }
.text-button { width:100%; margin:0; background:transparent; color:#5f625f; font-size:25rpx; }
.camera-error { margin-top:24rpx; padding:28rpx; display:flex; flex-direction:column; gap:18rpx; }
.camera-error button { margin:0; background:#e8e0d3; color:#382c24; }
.error-title { font-size:29rpx; font-weight:600; }
.hotspot-tabs { display:flex; gap:12rpx; overflow-x:auto; }
.hotspot-tab { flex:none; margin:0; padding:0 20rpx; min-height:66rpx; line-height:66rpx; border-radius:999rpx; background:#e5dfd3; color:#5e574f; font-size:23rpx; }
.hotspot-tab.active { background:#3a5a47; color:#fff; }
.hotspot-tab.visited:not(.active) { color:#31533f; border:1rpx solid #a8b8aa; }
.quest-heading { display:flex; align-items:flex-end; justify-content:space-between; }
.quest-heading > view { display:flex; flex-direction:column; gap:7rpx; }
.quest-kicker { color:#8a6a2b; font-size:21rpx; letter-spacing:2rpx; }
.quest-count { color:#3a5a47; font-size:34rpx; font-weight:700; }
.clue-track { height:8rpx; overflow:hidden; border-radius:999rpx; background:#ddd7ca; }
.clue-track-fill { height:100%; max-width:100%; border-radius:inherit; background:#3a5a47; transition:width .28s ease; }
.detail-card { padding:28rpx; display:flex; flex-direction:column; gap:12rpx; }
.detail-index,.quiz-label { color:#8a6a2b; font-size:22rpx; }
.detail-title,.quiz-title { font-size:33rpx; font-weight:600; }
.detail-description { color:#4f4842; font-size:26rpx; line-height:1.72; }
.review-notice { color:#7c756e; font-size:22rpx; line-height:1.55; }
.action-row { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; }
.action-row button { margin:0; padding:12rpx 18rpx; min-height:76rpx; line-height:1.35; border-radius:14rpx; background:#3a5a47; color:#fff; font-size:23rpx; display:flex; align-items:center; justify-content:center; text-align:center; box-sizing:border-box; }
.quiz-card { padding:28rpx; display:flex; flex-direction:column; gap:14rpx; }
.quiz-lock { padding:28rpx; display:flex; align-items:center; gap:24rpx; border-style:dashed; background:#f4efe5; }
.lock-mark { flex:none; width:76rpx; height:76rpx; border-radius:50%; background:#ded7ca; color:#7a7167; font-size:35rpx; line-height:76rpx; text-align:center; font-family:serif; }
.lock-copy { display:flex; flex-direction:column; gap:8rpx; color:#6e675f; font-size:23rpx; line-height:1.55; }
.quiz-card.passed { border-color:#9caf9e; background:#fbfcf7; }
.quiz-option { width:100%; margin:0; padding:18rpx 20rpx; line-height:1.45; border-radius:14rpx; background:#eee8dc; color:#4f4842; font-size:24rpx; text-align:left; display:flex; align-items:center; gap:16rpx; }
.quiz-option[disabled] { opacity:1; }
.option-letter { flex:none; width:42rpx; height:42rpx; border-radius:50%; background:rgba(56,44,36,.08); line-height:42rpx; text-align:center; font-size:21rpx; font-weight:700; }
.quiz-option.correct { background:#dfeadf; color:#294d39; }
.quiz-option.wrong { background:#f3ded7; color:#7b3b2f; }
.quiz-feedback { color:#8b493a; font-size:23rpx; }
.quiz-feedback.success { color:#3a5a47; }
.egg-reward { margin-top:8rpx; padding-top:24rpx; border-top:1rpx solid #d9dfd2; display:flex; align-items:center; gap:24rpx; }
.reward-seal { flex:none; width:116rpx; height:116rpx; border:4rpx double #9a5d35; border-radius:50%; display:flex; flex-direction:column; align-items:center; justify-content:center; color:#8a4e2d; font-size:20rpx; line-height:1.25; transform:rotate(-5deg); background:#f7ead7; }
.reward-copy { display:flex; flex-direction:column; gap:7rpx; }
.reward-overline { color:#8a6a2b; font-size:20rpx; letter-spacing:2rpx; }
.reward-title { color:#294d39; font-size:31rpx; font-weight:600; }
.restart-button { margin-bottom:22rpx; }
