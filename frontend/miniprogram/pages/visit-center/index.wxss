.heading { display:flex; flex-direction:column; gap:10rpx; margin-bottom:24rpx; }.heading .muted { font-size:23rpx; line-height:1.5; }.offline-notice,.state { margin-bottom:22rpx; padding:24rpx; }.state { display:flex; flex-direction:column; gap:18rpx; }
.progress-card,.route-card,.list-card,.data-card,.empty-card { margin-bottom:22rpx; padding:28rpx; }.progress-head,.card-head { display:flex; justify-content:space-between; align-items:flex-start; gap:20rpx; }.progress-head>view,.card-head>view { display:flex; flex-direction:column; gap:7rpx; }.progress-label,.card-label { color:#7b581b; font-size:21rpx; }.progress-count,.card-title { font-size:32rpx; font-weight:600; }.progress-percent { color:#536657; font-size:34rpx; }.progress-track { height:14rpx; margin-top:22rpx; overflow:hidden; border-radius:999rpx; background:#e4ddd0; }.progress-value { height:100%; border-radius:999rpx; background:#657761; }.text-button { flex:none; width:auto; margin:0; padding:0; background:transparent; color:#7b581b; font-size:21rpx; line-height:1.6; }.route-summary { display:flex; flex-direction:column; gap:8rpx; margin:20rpx 0; color:#5f5550; font-size:24rpx; }.secondary-button { margin:0; background:#ede8de; color:#382c24; border-radius:14rpx; font-size:25rpx; }.empty-card,.data-card { display:flex; flex-direction:column; gap:14rpx; color:#756a63; font-size:23rpx; line-height:1.55; }
.spot-list { margin-top:20rpx; border-top:1rpx solid #e6dec8; }.spot-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:18rpx 0; border-bottom:1rpx solid #eee7dc; }.spot-row:last-child { border-bottom:0; }.spot-copy { flex:1; display:flex; flex-direction:column; gap:4rpx; font-size:27rpx; }.spot-copy text:last-child { color:#81766f; font-size:20rpx; }.spot-row button { flex:none; width:auto; margin:0; padding:0 14rpx; line-height:52rpx; border-radius:10rpx; background:#f2ede3; color:#78685d; font-size:20rpx; }.empty-text { display:block; margin-top:18rpx; color:#8a817b; font-size:23rpx; }.danger-button { margin:8rpx 0 0; background:#fff4f0; color:#9a4d3f; border:1rpx solid #dfb9b0; border-radius:14rpx; font-size:24rpx; }
.note-row { padding:18rpx 0; border-bottom:1rpx solid #eee7dc; display:flex; flex-direction:column; gap:9rpx; }.note-row>view { display:flex; justify-content:space-between; gap:16rpx; font-size:27rpx; }.note-row>view text:last-child { color:#a56a16; font-size:21rpx; }.note-preview { color:#81766f; font-size:22rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.display-buttons { display:flex; gap:10rpx; }.display-buttons button { flex:1; margin:0; background:#f2ede3; color:#382c24; font-size:23rpx; }.display-buttons button.active,.contrast-button.active { background:#382c24; color:#fff; }.contrast-button { margin:0; background:#ede8de; color:#382c24; font-size:23rpx; }
.privacy-button { margin:0; background:#382c24; color:#fffaf0; border-radius:14rpx; font-size:25rpx; }
