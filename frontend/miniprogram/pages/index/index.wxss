.hero { height: 650rpx; position: relative; overflow:hidden; background:#1e1815; }
.hero-swiper { width:100%; height:100%; }
.hero-stage { position:relative; width:100%; height:100%; }
.hero-card { position:absolute; top:38rpx; height:530rpx; border-radius:22rpx; box-shadow:0 22rpx 45rpx rgba(12,8,5,.38); }
.hero-card-main { z-index:3; left:105rpx; width:540rpx; }
.hero-card-left, .hero-card-right { z-index:1; top:82rpx; width:280rpx; height:440rpx; opacity:.48; filter:blur(7rpx); transform:scale(.93); }
.hero-card-left { left:-120rpx; transform:rotate(-4deg) scale(.93); }
.hero-card-right { right:-120rpx; transform:rotate(4deg) scale(.93); }
.hero-shade { position:absolute; inset:0; z-index:4; width:100%; height:100%; pointer-events:none; background:linear-gradient(180deg, rgba(34,24,16,.02) 42%, rgba(34,24,16,.78)); }
.hero-copy { position: absolute; left: 40rpx; right: 40rpx; bottom: 56rpx; color: #fffaf0; display: flex; flex-direction: column; gap: 14rpx; }
.hero-copy { z-index:5; pointer-events:none; }
.hero-dots { position:absolute; z-index:5; right:40rpx; bottom:62rpx; display:flex; gap:10rpx; }
.hero-dot { width:10rpx; height:10rpx; border-radius:999rpx; background:rgba(255,250,240,.45); transition:width .25s ease, background .25s ease; }
.hero-dot.active { width:30rpx; background:#fffaf0; }
.eyebrow { font-size: 24rpx; letter-spacing: 5rpx; }
.title { font-size: 58rpx; font-weight: 600; }
.subtitle { font-size: 28rpx; }
.intro { margin: -22rpx 32rpx 0; padding: 36rpx; position: relative; display: flex; flex-direction: column; gap: 24rpx; }
.description { color: #4e4540; font-size: 28rpx; line-height: 1.7; }
.intro-actions { display:flex; gap:14rpx; }.intro-actions button { flex:1; margin:0; }.display-toggle { background:#ede8de; color:#3a5a47; border:1rpx solid #b9c5b6; border-radius:16rpx; font-size:26rpx; }
.continue-wrap { padding-top:22rpx; }.continue-card { padding:26rpx; display:flex; align-items:center; justify-content:space-between; gap:20rpx; }.continue-card>view { min-width:0; display:flex; flex-direction:column; gap:7rpx; }.continue-label { color:#7b581b; font-size:21rpx; }.continue-title { font-size:31rpx; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }.continue-description { color:#727671; font-size:22rpx; line-height:1.45; }.continue-card button { flex:none; width:auto; margin:0; padding:0 22rpx; line-height:64rpx; border-radius:999rpx; background:#3a5a47; color:#fff; font-size:23rpx; }
.feature-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.feature { padding: 28rpx; display: flex; flex-direction: column; gap: 12rpx; }
.feature-title { font-size: 32rpx; font-weight: 600; }
.feature .muted { font-size: 24rpx; }
.feature.visit-center { grid-column: 1 / -1; }

/* 2026-09-28 游客端视觉重设计，可由备份目录完整恢复 */
.page { background:#f5f7f2; color:#14231f; }
.hero { height:920rpx; background:#102823; overflow:hidden; }
.hero-swiper { height:600rpx; margin-top:34rpx; }
.hero-card { top:20rpx; height:520rpx; border-radius:28rpx; box-shadow:0 30rpx 60rpx rgba(4,16,13,.42); }
.hero-card-main { left:135rpx; width:480rpx; }
.hero-card-left,.hero-card-right { top:66rpx; width:260rpx; height:430rpx; opacity:.48; filter:blur(5rpx); }
.hero-card-left { left:-128rpx; }.hero-card-right { right:-128rpx; }
.hero-shade { background:linear-gradient(180deg,transparent 56%,rgba(16,40,35,.2)); }
.hero-copy { left:48rpx; right:48rpx; bottom:72rpx; gap:16rpx; color:#fcfdf8; }
.eyebrow { color:#efc675; font-size:22rpx; font-weight:700; letter-spacing:4rpx; }
.title { font-size:44rpx; line-height:1.2; font-weight:600; white-space:nowrap; letter-spacing:-1.5rpx; }
.subtitle { color:rgba(252,253,248,.78); font-size:27rpx; line-height:1.6; }
.hero-dots { right:auto; left:50%; bottom:300rpx; transform:translateX(-50%); }
.hero-dot { background:rgba(252,253,248,.3); }.hero-dot.active { background:#d39b3f; }
.intro { margin:-22rpx 32rpx 0; padding:38rpx; border:0; border-radius:28rpx; background:#fcfdf8; box-shadow:0 24rpx 60rpx rgba(16,40,35,.1); }
.section-title,.feature-title,.continue-title { color:#14231f; }
.description { color:#66756e; }
.primary-button { background:#d39b3f; color:#17251f; border-radius:18rpx; font-weight:700; }
.display-toggle { background:#edf1ed; color:#102823; border:0; border-radius:18rpx; font-weight:700; }
.continue-card { border:0; border-radius:28rpx; box-shadow:0 16rpx 42rpx rgba(16,40,35,.08); }
.continue-label { color:#8b5c16; }.continue-card button { background:#102823; }
.feature-grid { gap:18rpx; padding-bottom:30rpx; }
.feature { min-height:170rpx; justify-content:flex-end; border:0; border-radius:28rpx; background:#102823; color:#fcfdf8; }
.feature:nth-child(2) { background:#2f4941; }
.feature.visit-center { min-height:140rpx; background:#24443b; }
.feature .feature-title { color:#fcfdf8; }.feature .muted { color:rgba(252,253,248,.68); }
.high-contrast .hero,.high-contrast .feature { background:#111; }
.font-large .title { font-size:48rpx !important; white-space:normal; }
@keyframes visitor-page-fade { from { opacity:.72; } to { opacity:1; } }
.page { animation:visitor-page-fade 260ms ease-out both; }
@media (prefers-reduced-motion: reduce) { .page { animation:none; } }

/* 用户反馈：侧图固定为单层，避免swiper切换时两组虚化图交叠 */
.hero { background:#3a5a47; }
.hero-side-stage { position:absolute; z-index:1; left:0; right:0; top:34rpx; height:600rpx; overflow:hidden; pointer-events:none; }
.hero-swiper { position:relative; z-index:2; }
.hero-side-stage .hero-card-left,.hero-side-stage .hero-card-right { top:66rpx; }
.hero-shade { background:linear-gradient(180deg,transparent 56%,rgba(69,107,85,.16)); }
.intro { margin:30rpx 32rpx 0; box-shadow:0 20rpx 50rpx rgba(67,88,80,.09); }
.display-toggle { color:#4f655d; background:#edf1ee; }
.continue-card button { background:#3a5a47; }
.feature { background:#3a5a47; }
.feature:nth-child(2) { background:#4b6955; }
.feature.visit-center { background:#587761; }
